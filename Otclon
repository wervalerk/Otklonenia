            parse_mode=ParseMode.MARKDOWN,
        )
        await state.set_state(Form.wait_dxf)
        return

    try:
        await download_doc(msg, p, DXF_MAX_BYTES)
    except FileTooBig as e:
        await msg.answer(
            f"⚠️ DXF слишком большой: *{human_mb(e.size)}* "
            f"(фактический размер после загрузки).\n"
            f"Лимит — *{DXF_MAX_MB} МБ*. Файл не принят, "
            "старый валидный DXF не испорчен. Пришлите поменьше.",
            parse_mode=ParseMode.MARKDOWN,
        )
        await state.set_state(Form.wait_dxf)
        return
    except Exception as e:
        await msg.answer(
            f"Не удалось скачать DXF: `{md_code(e)}`. Пришлите ещё раз.",
            parse_mode=ParseMode.MARKDOWN,
        )
        await state.set_state(Form.wait_dxf)
        return

    await state.update_data(
        dxf_path=p,
        dxf_name=fname,
        shift_checked=False,
        swap_xy=False,
        cs_done=False,
    )
    await msg.answer("DXF принят. Сначала *Модуль 0*: сверяю СК…")
    await run_cs_check(msg, state)


