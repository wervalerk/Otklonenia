def walk(entities, depth=0):
    for e in entities:
        if e.dxftype() == "INSERT" and depth < 3:
            try:
                yield from walk(e.virtual_entities(), depth + 1)
            except Exception:
                continue
        else:
            yield e


def manual_pts(e):
    t = e.dxftype()
    if t == "LWPOLYLINE":
        z = float(e.dxf.get("elevation", 0.0) or 0.0)
        return (
            [(p[0], p[1], z) for p in e.get_points("xy")],
            bool(getattr(e, "closed", False)),
        )
    if t == "POLYLINE":
        return (
            [
                (v.dxf.location.x, v.dxf.location.y, v.dxf.location.z)
                for v in e.vertices
            ],
            bool(getattr(e, "is_closed", False)),
        )
    if t == "LINE":
        s, e2 = e.dxf.start, e.dxf.end
        return [(s.x, s.y, s.z), (e2.x, e2.y, e2.z)], False
    if t == "ARC":
        c, r = e.dxf.center, e.dxf.radius
        a0, a1 = e.dxf.start_angle, e.dxf.end_angle
        if a1 < a0:
            a1 += 360.0
        n = max(16, int((a1 - a0) / 5) + 1)
        return [
            (
                c.x + r * math.cos(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                c.y + r * math.sin(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                c.z,
            )
            for i in range(n)
        ], False
    return [], False


def raw_path(e):
    if e.dxftype() not in SUPPORTED:
        return None
    try:
        ext = bbox.extents([e])
        local = max(
            abs(ext.extmin.x),
            abs(ext.extmin.y),
            abs(ext.extmax.x),
            abs(ext.extmax.y),
        )
    except Exception:
        local = 1000.0

    flat = max(local * 2e-4, 1e-3)

    try:
        p = make_path(e)
        pts = [(v.x, v.y, v.z) for v in p.flattening(flat)]
        closed = bool(getattr(p, "is_closed", False))
    except Exception:
        pts, closed = manual_pts(e)

    closed = (
        closed
        or bool(getattr(e, "closed", False))
        or bool(getattr(e, "is_closed", False))
    )

    if len(pts) < 2:
        return None

    if closed and math.hypot(
        pts[-1][0] - pts[0][0],
        pts[-1][1] - pts[0][1],
    ) > 1e-9:
        pts.append(pts[0])

    return {"pts": pts, "closed": closed, "layer": e.dxf.layer}


def choose_scale(doc, maxabs, override):
    if override:
        return (
            {"m": 1.0, "cm": 0.01, "mm": 0.001}[override],
            f"DXFUNITS={override} (из TXT)",
        )
    u = int(doc.header.get("$INSUNITS", 0) or 0)
    tbl = {
        1: 0.0254,
        2: 0.3048,
        4: 0.001,
        5: 0.01,
        6: 1.0,
        7: 1000.0,
        10: 0.9144,
    }
    if u in tbl:
        return tbl[u], f"$INSUNITS={u}"
    if maxabs > 1000.0:
        return 0.001, "$INSUNITS=0 → принял мм"
    return 1.0, "$INSUNITS=0 → принял м"


def parse_dxf(path, shift, dxfunits_override, level_tol) -> DxfData:
    doc = ezdxf.readfile(path)
    raw = [r for r in (raw_path(e) for e in walk(doc.modelspace())) if r]
    if not raw:
        raise ValueError(
            "Не найдено LWPOLYLINE / POLYLINE / LINE / ARC "
            "(в т.ч. в блоках)."
        )

    coords = [
        v
        for r in raw
        for p in r["pts"]
        for v in (p[0], p[1])
    ]

    scale, note = choose_scale(
        doc,
        max(abs(v) for v in coords),
        dxfunits_override,
    )

    dx, dy = shift
    polylines, segments, contour_z = [], [], []

    for r in raw:
        pts_m = [
            (x * scale + dx, y * scale + dy, z * scale)
            for x, y, z in r["pts"]
        ]
        contour_z.append(sum(p[2] for p in pts_m) / len(pts_m))
        polylines.append((pts_m, r["closed"], r["layer"]))

        for a, b in zip(pts_m, pts_m[1:]):
            if (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2 < 1e-18:
                continue
            segments.append(Seg(*a, *b, r["layer"]))

    if not segments:
        raise ValueError("После приведения единиц не осталось отрезков.")

    distinct = {round(z, 3) for z in contour_z}
    has_z = len(distinct) > 1 or any(abs(z) > 1e-9 for z in contour_z)

    return DxfData(
        polylines,
        segments,
        note,
        has_z,
        cluster_levels(contour_z, level_tol) if has_z else [],
    )


# ─────────────── Расчёт ТОЛЬКО плановых смещений ───────────────

def compute(txt: TxtData, dxf: DxfData):
    rows = []
    for pid, x, y, h in txt.points:
        same, other = [], []

        for si, s in enumerate(dxf.segments):
            vx, vy = s.bx - s.ax, s.by - s.ay
            t = ((x - s.ax) * vx + (y - s.ay) * vy) / (vx * vx + vy * vy)
            t = 0.0 if t < 0 else (1.0 if t > 1 else t)

            qx, qy = s.ax + t * vx, s.ay + t * vy
            qz = s.az + t * (s.bz - s.az)
            d = math.hypot(x - qx, y - qy)
            cross = vx * (y - s.ay) - vy * (x - s.ax)
            dp = (1.0 if cross >= 0 else -1.0) * d * 1000.0

            c = {
                "d": d,
                "dp": dp,
                "qx": qx,
                "qy": qy,
                "qz": qz,
                "dz": abs(qz - h),
                "layer": s.layer,
                "si": si,
            }

            if not dxf.has_z or c["dz"] <= txt.level_tol:
                same.append(c)
            else:
                other.append(c)

        if not same and other:
            zmin = min(c["dz"] for c in other)
            same = [c for c in other if c["dz"] <= zmin + txt.level_tol]

        best = min(same or other, key=lambda c: c["d"])
        dp = 0.0 if abs(best["dp"]) < 0.5 else best["dp"]

        rows.append({
            "pid": pid,
            "p": (x, y),
            "q": (best["qx"], best["qy"]),
            "h": h,
            "qz": best["qz"],
            "dz": best["dz"],
            "d_m": best["d"],
            "dp": dp,
            "layer": best["layer"],
            "si": best["si"],
            "over": abs(dp) > txt.tol_mm,
            "mismatch": bool(
                dxf.has_z
                and other
                and not any(
                    c["dz"] <= txt.level_tol
                    for c in (same + other)
                )
            ),
        })
    return rows


def geom_offset(dxf, rows):
    xs = [p[0] for r in rows for p in (r["p"], r["q"])]
    ys = [p[1] for r in rows for p in (r["p"], r["q"])]

    for pts, _, _ in dxf.polylines:
        xs += [p[0] for p in pts]
        ys += [p[1] for p in pts]

    span = max(max(xs) - min(xs), max(ys) - min(ys), 1e-6)
    off = min(max(span * 0.0030, 0.012), 0.20)
    return off, off * 0.70 * TEXT_SCALE


# ═══════════ СТАНДАРТНАЯ СТРЕЛКА + ВЫБОР СВОБОДНОЙ СТОРОНЫ ═══════════

def _safe_segment(dxf, row):
    segs = getattr(dxf, "segments", None)
    if not segs:
        return None

    si = row.get("si") if isinstance(row, dict) else None
    try:
        si = int(si)
    except (TypeError, ValueError):
        si = None

    if si is not None and 0 <= si < len(segs):
        return segs[si]

    qx, qy = row.get("q", row.get("p", (0.0, 0.0)))
    return min(segs, key=lambda s: _seg_xy_dist(qx, qy, s))


def _source_index(row, dxf) -> int:
    segs = getattr(dxf, "segments", None)
    if not segs:
        return -1
    si = row.get("si") if isinstance(row, dict) else None
    try:
        si = int(si)
    except (TypeError, ValueError):
        return -1
    if 0 <= si < len(segs):
        return si
    return -1


def _perp_normal(seg, prefer=None):
    """Единичная нормаль к сегменту. Если prefer задан — выбираем сторону
    с положительным скалярным произведением на prefer."""
    if seg is None:
        return (1.0, 0.0)
    ex, ey = seg.bx - seg.ax, seg.by - seg.ay
    el = math.hypot(ex, ey) or 1.0
    nx, ny = -ey / el, ex / el
    if prefer is not None and (nx * prefer[0] + ny * prefer[1]) < 0:
        nx, ny = -nx, -ny
    return (nx, ny)


def offset_dir(rows_subset, dxf):
    """
    Направление стрелки / сдвига подписи:
    ВСЕГДА перпендикулярно полилинии (90°), в сторону фактической точки
    (или в сторону dp, если точка почти на линии).
    """
    r0 = rows_subset[0]
    s = _safe_segment(dxf, r0)

    # предпочтение: куда лежит точка относительно q
    prefer = (r0["p"][0] - r0["q"][0], r0["p"][1] - r0["q"][1])
    if math.hypot(*prefer) < 1e-9:
        # точка почти на линии — по знаку dp
        prefer = (1.0, 0.0) if r0.get("dp", 0.0) >= 0 else (-1.0, 0.0)

    return _perp_normal(s, prefer)


def text_angle(rows_subset, dxf, u=None) -> float:
    """Угол текста = угол нормали (подпись вдоль нормали, ⟂ линии)."""
    if u is None:
        u = offset_dir(rows_subset, dxf)
    theta = math.degrees(math.atan2(u[1], u[0]))
    # держим текст читаемым (не вверх ногами)
    if theta > 90.0:
        theta -= 180.0
    if theta < -90.0:
        theta += 180.0
    if abs(theta + 90.0) < 1.0:
        theta = 90.0
    return theta


def standard_arrow(q, u, off, ptk):
    """
    Стрелка строго по нормали: от полилинии в сторону смещения.
    Длина ×2 относительно предыдущей версии (было 1.40 → 2.80).
    """
    L = off * 2.80 * ptk
    ux, uy = u
    start = (q[0] + ux * L * 0.03, q[1] + uy * L * 0.03)
    end = (q[0] + ux * L, q[1] + uy * L)
    head = L * 0.28
    wing = head * 0.38
    px, py = -uy, ux
    a1 = (
        end[0] - ux * head + px * wing,
        end[1] - uy * head + py * wing,
    )
    a2 = (
        end[0] - ux * head - px * wing,
        end[1] - uy * head - py * wing,
    )
    return {
        "start": start,
        "end": end,
        "a1": a1,
        "a2": a2,
        "L": L,
    }


def _add_unique_dir(dirs, d):
    L = math.hypot(d[0], d[1])
    if L <= 1e-9:
        return
    d = (d[0] / L, d[1] / L)
    for e in dirs:
        if d[0] * e[0] + d[1] * e[1] > 0.985:
            return
    dirs.append(d)


def _candidate_dirs(ordered, dxf):
    """Только две нормали (±90° к полилинии). Вдоль линии не предлагаем —
    стрелка должна быть строго перпендикулярна."""
    dirs = []
    u = offset_dir(ordered, dxf)
    _add_unique_dir(dirs, u)
    _add_unique_dir(dirs, (-u[0], -u[1]))

    s = _safe_segment(dxf, ordered[0])
    if s is not None:
        n = _perp_normal(s, None)
        _add_unique_dir(dirs, n)
        _add_unique_dir(dirs, (-n[0], -n[1]))

    if not dirs:
        dirs = [(1.0, 0.0), (-1.0, 0.0)]
    return dirs[:4]


def _near_segments(q, dxf, radius):
    qx, qy = q
    out = []
    for idx, s in enumerate(dxf.segments):
        if max(s.ax, s.bx) < qx - radius:
            continue
        if min(s.ax, s.bx) > qx + radius:
            continue
        if max(s.ay, s.by) < qy - radius:
            continue
        if min(s.ay, s.by) > qy + radius:
            continue
        out.append((idx, s))
    return out


# Полоса «рядом» для параллельных линий (метры)
NEAR_PARALLEL_MIN = 0.10   # 10 см
NEAR_PARALLEL_MAX = 1.00   # 1 м
PARALLEL_DOT_MIN = 0.92    # |cos| направлений ≥ 0.92 ≈ ±23°


def _seg_dir(s):
    ex, ey = s.bx - s.ax, s.by - s.ay
    el = math.hypot(ex, ey)
    if el < 1e-12:
        return None
    return (ex / el, ey / el)


def _parallel_side_push(q, src_seg, dxf, src_idx):
    """
    Ищет параллельные сегменты в полосе 0.10…1.00 м от точки q.
    Возвращает единичный вектор «от параллельных стен» (куда лучше
    сдвинуть подпись). Если параллельных нет — None (одиночная линия,
    сторона любая).
    """
    if src_seg is None:
        return None

    td = _seg_dir(src_seg)
    if td is None:
        return None
    tx, ty = td
    # нормаль к исходной линии (две стороны)
    n_left = (-ty, tx)
    n_right = (ty, -tx)

    # собираем параллельные в полосе
    left_w = 0.0
    right_w = 0.0
    found = 0

    # радиус поиска чуть больше MAX, чтобы не пропустить
    near = _near_segments(q, dxf, NEAR_PARALLEL_MAX + 0.15)

    for idx, s in near:
        if idx == src_idx:
            continue
        d_here = _seg_xy_dist(q[0], q[1], s)
        if d_here < NEAR_PARALLEL_MIN or d_here > NEAR_PARALLEL_MAX:
            continue

        sd = _seg_dir(s)
        if sd is None:
            continue
        # параллельность: |dot| близко к 1
        if abs(sd[0] * tx + sd[1] * ty) < PARALLEL_DOT_MIN:
            continue

        # на какой стороне лежит сегмент относительно src
        # берём середину чужого сегмента
        mx = 0.5 * (s.ax + s.bx)
        my = 0.5 * (s.ay + s.by)
        side = (mx - q[0]) * n_left[0] + (my - q[1]) * n_left[1]

        # вес обратно пропорционален расстоянию (ближе = сильнее толкает)
        w = 1.0 / max(d_here, NEAR_PARALLEL_MIN)
        if side >= 0:
            left_w += w
        else:
            right_w += w
        found += 1

    if found == 0:
        return None  # одиночная линия

    # толкаем в сторону с меньшим «весом» параллельных (свободнее)
    if left_w < right_w:
        return n_left
    if right_w < left_w:
        return n_right
    # одинаково зажато — не навязываем
    return None


def _point_clearance(x, y, q, near_segments, off, src_idx):
    best = off * 20.0
    qx, qy = q

    for idx, s in near_segments:
        if idx == src_idx:
            continue
        if _seg_xy_dist(qx, qy, s) <= off * 0.20:
            continue

        dd = _seg_xy_dist(x, y, s)
        if dd < best:
            best = dd
        if best <= off * 0.05:
            break

    return best


def _direction_clearance(q, d, near_segments, off, src_idx, probe):
    best = probe
    steps = 9

    for i in range(1, steps + 1):
        t = probe * i / steps
        px = q[0] + d[0] * t
        py = q[1] + d[1] * t
        c = _point_clearance(px, py, q, near_segments, off, src_idx)
        if c < best:
            best = c
        if best <= off * 0.10:
            break

    return min(best, probe)


def _box_clearance(cbox, q, near_segments, off, src_idx):
    x, y, bw, bh = cbox
    pts = [
        (x, y),
        (x + bw, y),
        (x, y + bh),
        (x + bw, y + bh),
        (x + bw / 2.0, y + bh / 2.0),
    ]
    return min(
        _point_clearance(px, py, q, near_segments, off, src_idx)
        for px, py in pts
    )


def _boxes_overlap(a, b, pad):
    return not (
        a[0] + a[2] + pad < b[0]
        or b[0] + b[2] + pad < a[0]
        or a[1] + a[3] + pad < b[1]
        or b[1] + b[3] + pad < a[1]
    )


def make_flags(rows, txt, dxf, off):
    use = [r for r in rows if r.get("in_flag")]

    groups: Dict[object, List[dict]] = {}
    for i, r in enumerate(use):
        groups.setdefault(
            r.get("pair_key") or ("one", i),
            [],
        ).append(r)

    raw: List[List[dict]] = []
    for g in groups.values():
        up = next((r for r in g if r["mark"] == MARKS[1]), None)
        dn = next((r for r in g if r["mark"] == MARKS[0]), None)
        raw.append(
            [r for r in (up, dn) if r]
            or sorted(g, key=pid_sort)[:1]
        )

    # Размеры подписи. Буква и цифра одной высоты, стоят друг за другом.
    # Небольшое смещение от точки (от наконечника стрелки).
    ch = off * 0.62 * TEXT_SCALE
    lw = ch * 0.90          # ширина под букву
    vw = ch * 2.50          # ширина под цифру (±xx)
    w = lw + vw
    pad = ch * 0.18
    gap = ch * 0.12         # небольшое смещение от наконечника / точки

    # Небольшие смещения вдоль нормали / вдоль линии — чтобы развести соседей,
    # но не уносить далеко от полилинии.
    micro_perp = [0.0, 0.25, -0.25, 0.55, -0.55, 0.90, -0.90]
    micro_along = [0.0, 0.20, 0.45, -0.20]

    # --- лёгкое прореживание очень близких одиночных точек ---
    # Если две одиночные подписи ближе 0.55*off и |Δ| почти одинаковый —
    # оставляем первую. Пары В/Н не трогаем.
    # ВАЖНО: used_q всегда хранит кортежи (q, dp), где q = (x, y).
    # Раньше при парах клали только q → потом unpack делал prev_q = float
    # и падало с "'float' object is not subscriptable".
    thinned: List[List[dict]] = []
    used_q: List[Tuple[Tuple[float, float], float]] = []
    for ordered in raw:
        if len(ordered) > 1:          # пары В/Н не трогаем
            thinned.append(ordered)
            q0 = ordered[0]["q"]
            # защита: q должен быть (x, y)
            if not (isinstance(q0, (tuple, list)) and len(q0) >= 2):
                continue
            dp0 = abs(float(ordered[0].get("dp", 0.0) or 0.0))
            used_q.append(((float(q0[0]), float(q0[1])), dp0))
            continue
        q = ordered[0]["q"]
        if not (isinstance(q, (tuple, list)) and len(q) >= 2):
            thinned.append(ordered)
            continue
        q = (float(q[0]), float(q[1]))
        dp = abs(float(ordered[0].get("dp", 0.0) or 0.0))
        too_close = False
        for prev_q, prev_dp in used_q:
            if math.hypot(q[0] - prev_q[0], q[1] - prev_q[1]) < off * 0.55:
                if abs(dp - prev_dp) < max(txt.red_mm * 0.4, 3.0):
                    too_close = True
                    break
        if not too_close:
            thinned.append(ordered)
            used_q.append((q, dp))

    occupied = []
    flags = []

    for ordered in thinned:
        row0 = ordered[0]
        q = row0["q"]
        src_idx = _source_index(row0, dxf)
        u_real = offset_dir(ordered, dxf)

        probe = max(off * 9.0, (w + 2.5 * ch) * 1.6)
        near_segments = _near_segments(q, dxf, probe * 1.25)
        dirs = _candidate_dirs(ordered, dxf)

        seg0 = _safe_segment(dxf, row0)
        if seg0 is None:
            n0 = (0.0, 1.0)
        else:
            ex, ey = seg0.bx - seg0.ax, seg0.by - seg0.ay
            el = math.hypot(ex, ey) or 1.0
            n0 = (-ey / el, ex / el)

        # Параллельные линии в полосе 0.10…1.00 м → толкаем подпись от них
        push = _parallel_side_push(q, seg0, dxf, src_idx)
        if push is not None:
            _add_unique_dir(dirs, push)
            # противоположную тоже оставляем как запасной вариант
            _add_unique_dir(dirs, (-push[0], -push[1]))

        candidates = []

        for d in dirs:
            theta = text_angle(ordered, dxf, d)
            ar = standard_arrow(q, d, off, txt.pt_k)

            row_h = ch * (1.85 if abs(theta) > 45.0 else 1.0)
            cnt = len(ordered)
            h = row_h * cnt

            if abs(theta) > 45.0:
                bw, bh = h, w
            else:
                bw, bh = w, h

            dir_clear = _direction_clearance(
                q, d, near_segments, off, src_idx, probe,
            )

            real_bonus = 0.14 * off * (d[0] * u_real[0] + d[1] * u_real[1])
            normal_bonus = 0.08 * off * abs(d[0] * n0[0] + d[1] * n0[1])

            # Бонус за сторону «от параллельных стен»
            # (если параллельных нет — push=None, бонус 0)
            push_bonus = 0.0
            if push is not None:
                push_bonus = 0.22 * off * (d[0] * push[0] + d[1] * push[1])

            dx, dy = d
            px, py = -dy, dx

            for along in micro_along:
                for perp in micro_perp:
                    base_x = (
                        ar["end"][0]
                        + dx * (gap + along * ch)
                        + px * perp * ch
                    )
                    base_y = (
                        ar["end"][1]
                        + dy * (gap + along * ch)
                        + py * perp * ch
                    )

                    bx = base_x - (w if dx < 0 else 0.0)
                    by = base_y - h / 2.0

                    box = (bx, by, w, h)
                    cbox = (bx, by, bw, bh)

                    overlap = any(
                        _boxes_overlap(cbox, b, pad)
                        for b in occupied
                    )

                    box_clear = _box_clearance(
                        cbox, q, near_segments, off, src_idx,
                    )

                    # Сильнее наказываем пересечения — главная причина «каши»
                    score = (
                        dir_clear
                        + 0.70 * box_clear
                        + real_bonus
                        + normal_bonus
                        + push_bonus
                        - (abs(perp) * 0.04 + along * 0.06) * off
                        - (18.0 * off if overlap else 0.0)
                    )

                    flag = {
                        "rows": ordered,
                        "q": q,
                        "u": d,
                        "angle": theta,
                        "arrow": ar,
                        "box": box,
                        "cbox": cbox,
                        "ch": ch,
                        "row_h": row_h,
                        "cols": (lw, vw),
                        "lines": [
                            (
                                r["mark"] or "·",
                                f"{r['dp']:+.0f}",
                                abs(r["dp"]) > txt.red_mm,
                            )
                            for r in ordered
                        ],
                        "pair": len(ordered) > 1,
                    }
                    candidates.append((score, flag, overlap))

        free = [c for c in candidates if not c[2]]
        _best_score, best_flag, _overlap = max(
            free or candidates,
            key=lambda c: c[0],
        )

        occupied.append(best_flag["cbox"])
        flags.append(best_flag)

    return flags


# ═══════════ Кэш глифов: без TextPath и без try в цикле отрисовки ═══════════

_GLYPH_BAD = re.compile(r"[^0-9A-Za-zА-Яа-яЁё+\-·]")


def _glyph_text(s) -> str:
    t = str(s).replace("\u2212", "-").replace("−", "-")
    t = _GLYPH_BAD.sub("", t)
    return t or "·"


@lru_cache(maxsize=1024)
def _text_path_cached(s: str):
    t = _glyph_text(s)
    tp = TextPath((0, 0), t, size=1.0, prop=cyr_fp())
    bb = tp.get_extents()

    if (
        not math.isfinite(bb.width)
        or not math.isfinite(bb.height)
        or bb.width <= 0
        or bb.height <= 0
    ):
        t = "·"
        tp = TextPath((0, 0), t, size=1.0, prop=cyr_fp())
        bb = tp.get_extents()

    return (
        tp,
        float(bb.x0),
        max(float(bb.width), 1e-6),
        max(float(bb.height), 1e-6),
    )


@lru_cache(maxsize=2048)
def _flag_pair_cached(letter: str, val: str):
    """
    Буква + цифра СТРОГО одной высоты, на одной базовой линии.
    Оба глифа рисуются с одним font size, выравниваются по baseline,
    затем общий масштаб подгоняет пару под target_h.
    """
    tl, x0l, wl, hl = _text_path_cached(letter)
    tv, x0v, wv, hv = _text_path_cached(val)

    # Общая опорная высота = max(hl, hv) — оба глифа масштабируем
    # одинаково, чтобы визуальная высота совпадала точно.
    href = max(hl, hv, 1e-6)
    k_common = 1.0 / href

    # маленький зазор между буквой и цифрой
    gap = 0.08 * href  # в единицах исходного size=1.0

    # оба: сдвиг к x=0, вниз на свой y0 (baseline), общий scale
    p_l = tl.transformed(
        Affine2D()
        .translate(-x0l, 0.0)
        .scale(k_common, k_common)
    )
    # ширина буквы после scale
    w_letter = wl * k_common
    p_v = tv.transformed(
        Affine2D()
        .translate(-x0v, 0.0)
        .scale(k_common, k_common)
        .translate(w_letter + gap * k_common, 0.0)
    )

    bl, bv = p_l.get_extents(), p_v.get_extents()
    xmin = min(bl.x0, bv.x0)
    xmax = max(bl.x1, bv.x1)
    ymin = min(bl.y0, bv.y0)
    ymax = max(bl.y1, bv.y1)

    total_w = max(xmax - xmin, 1e-6)
    total_h = max(ymax - ymin, 1e-6)
    local_cx = (xmin + xmax) / 2.0
    local_cy = (ymin + ymax) / 2.0

    return p_l, p_v, total_w, total_h, local_cx, local_cy


def draw_flag_line(
    ax,
    x0,
    y0,
    w,
    cell_h,
    letter,
    val,
    hot,
    angle: float = 0.0,
    z=9,
):
    p_l, p_v, tw, th, local_cx, local_cy = _flag_pair_cached(
        str(letter),
        str(val),
    )

    # СТРОГО одна высота: масштаб только по высоте пары.
    # Ширину не режем — буква и цифра остаются одной высоты.
    target_h = cell_h * TEXT_FILL
    k = target_h / max(th, 1e-6)

    cx = x0 + w / 2.0
    cy = y0 + cell_h / 2.0

    tr = (
        Affine2D()
        .scale(k, k)
        .translate(cx - k * local_cx, cy - k * local_cy)
        .rotate_deg_around(cx, cy, angle)
    )

    ax.add_patch(PathPatch(
        p_l.transformed(tr),
        facecolor=INK,
        edgecolor="none",
        linewidth=0,
        zorder=z,
    ))

    ax.add_patch(PathPatch(
        p_v.transformed(tr),
        facecolor=RED if hot else INK,
        edgecolor="none",
        linewidth=0,
        zorder=z,
    ))


def _new_fig():
    fig, ax = plt.subplots(figsize=(11.7, 8.3))
    fig.subplots_adjust(0, 0, 1, 1)
    return fig, ax


def render_scene(ax, dxf, rows, flags, txt):
    off, ptk = txt.off, txt.pt_k

    # 1) тонкий серый контур проекта
    for pts, _, _ in dxf.polylines:
        ax.plot(
            [p[0] for p in pts],
            [p[1] for p in pts],
            color=GREY,
            lw=0.55,
            zorder=1,
        )

    # 2) крестик в фактической точке
    cr = off * 0.30 * ptk
    for r in rows:
        x, y = r["p"]
        ax.plot(
            [x - cr, x + cr],
            [y, y],
            color=CROSS_COLOR,
            lw=0.55,
            zorder=3,
        )
        ax.plot(
            [x, x],
            [y - cr, y + cr],
            color=CROSS_COLOR,
            lw=0.55,
            zorder=3,
        )

    # 3) стандартная стрелка + подпись на одной базе
    for f in flags:
        ar = f["arrow"]

        ax.plot(
            [ar["start"][0], ar["end"][0]],
            [ar["start"][1], ar["end"][1]],
            color=INK,
            lw=0.30,
            zorder=4,
        )
        ax.plot(
            [ar["end"][0], ar["a1"][0]],
            [ar["end"][1], ar["a1"][1]],
            color=INK,
            lw=0.30,
            zorder=4,
        )
        ax.plot(
            [ar["end"][0], ar["a2"][0]],
            [ar["end"][1], ar["a2"][1]],
            color=INK,
            lw=0.30,
            zorder=4,
        )

        x0, y0, _, _ = f["box"]
        row_h = f["row_h"]
        w = f["cols"][0] + f["cols"][1]
        cnt = len(f["lines"])
        ang = f["angle"]
        # локальная «вверх» для стека В над Н (⟂ базовой линии текста)
        rad = math.radians(ang)
        up_x = -math.sin(rad)
        up_y = math.cos(rad)

        for k, (letter, val, hot) in enumerate(f["lines"]):
            # k=0 → В (верх), k=1 → Н (низ)
            stack = (cnt - 1 - k) * row_h
            lx = x0 + up_x * stack
            ly = y0 + up_y * stack
            draw_flag_line(
                ax,
                lx,
                ly,
                w,
                row_h,
                letter,
                val,
                hot,
                ang,
            )

    ax.relim()

    for f in flags:
        x0, y0, w, h = f["box"]
        bw, bh = (h, w) if abs(f["angle"]) > 45.0 else (w, h)
        ax.update_datalim([
            (x0, y0),
            (x0 + bw, y0 + bh),
        ])
        ar = f["arrow"]
        ax.update_datalim([
            ar["start"],
            ar["end"],
            ar["a1"],
            ar["a2"],
        ])

    ax.autoscale_view()
    ax.set_aspect("equal", adjustable="datalim")
    ax.set_axis_off()


def _save(fig, path, fmt, dpi=190):
    fig.savefig(
