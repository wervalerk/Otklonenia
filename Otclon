async def download_doc(
    msg: types.Message,
    dest: str,
    max_bytes: Optional[int] = None,
):
    f = await msg.bot.get_file(msg.document.file_id)
    declared = (
        msg.document.file_size
        or getattr(f, "file_size", None)
        or 0
    )
    if max_bytes and declared > max_bytes:
        raise FileTooBig(int(declared), max_bytes)

    part = dest + ".part"
    try:
        await msg.bot.download_file(f.file_path, part)
        real = os.path.getsize(part)
        if max_bytes and real > max_bytes:
            raise FileTooBig(real, max_bytes)
        os.replace(part, dest)
    finally:
        if os.path.exists(part):
            try:
                os.remove(part)
            except OSError:
                pass
    return dest


