def _med_warn(data, rows) -> str:
    med = statistics.median(r["d_m"] for r in rows)
    if med > SHIFT_M and data.get("shift_checked"):
        return (
            f"⚠️ СК не рядом даже после `X0 Y0` (медиана {med:,.1f} м) — "
            "жмите *🔁 Перепроверить СК* или /start."
        )
    return ""


async def make_preview(
    msg: types.Message,
    state: FSMContext,
    edit: bool = False,
):
    data = await state.get_data()

    try:
        txt, dxf, rows, off, th, flags, marks = build_scene(data)
    except Exception as e:
        await msg.answer(
            f"Ошибка DXF: `{md_code(e)}`\nПришлите другой файл.",
            parse_mode=ParseMode.MARKDOWN,
        )
        await state.set_state(Form.wait_dxf)
        return

    med = statistics.median(r["d_m"] for r in rows)
    if med > SHIFT_M and not data.get("shift_checked"):
        await state.update_data(shift_checked=True, cs_done=False)
        await state.set_state(Form.wait_shift)
        await msg.answer(
            f"⚠️ Медианное расстояние *{med:,.1f} м* "
            f"(порог {SHIFT_M:.0f}). "
            "Пришлите `X0 Y0` — привязку нуля DXF в осях DXF. "
            "Авто-центрирование не делаю: обнулило бы отклонение.",
            parse_mode=ParseMode.MARKDOWN,
            reply_markup=recheck_kb(),
        )
        return

    d2 = await state.get_data()
    stem = out_stem(d2)
    name_mode = d2.get("name_mode", "auto")

    caption = preview_caption(
        txt,
        dxf,
        rows,
        flags,
        marks,
        swapped=bool(d2.get("swap_xy")),
        warn=_med_warn(d2, rows),
        stem=stem,
        name_mode=name_mode,
    )
    kb = preview_kb(txt.pt_k, stem, name_mode)

    png = os.path.join(d2["tmp"], "preview.png")
    write_png(png, dxf, rows, flags, txt)

    await state.update_data(out_png=png, pt_k=txt.pt_k)
    await state.set_state(Form.preview)

    if edit:
        try:
            await msg.edit_media(
                media=edit_photo(png, caption),
                reply_markup=kb,
            )
            return
        except Exception:
            pass

    await msg.answer_photo(
        FSInputFile(png),
        caption=caption,
        parse_mode=ParseMode.MARKDOWN,
        reply_markup=kb,
    )


async def rerender_preview(
    c: types.CallbackQuery,
    state: FSMContext,
    delta: float,
):
    data = await state.get_data()
    ptk = clamp_pt(data.get("pt_k", 1.0) + delta)
    await state.update_data(pt_k=ptk)

    d2 = await state.get_data()
    try:
        txt, dxf, rows, off, th, flags, marks = build_scene(d2)
    except Exception as e:
        await c.answer(f"Ошибка: `{md_code(e)}`", show_alert=True)
        return

    stem = out_stem(d2)
    name_mode = d2.get("name_mode", "auto")
    png = os.path.join(d2["tmp"], "preview.png")
    write_png(png, dxf, rows, flags, txt)
    await state.update_data(out_png=png)

    await c.message.edit_media(
        media=edit_photo(png, preview_caption(
            txt, dxf, rows, flags, marks,
            swapped=bool(d2.get("swap_xy")),
            warn=_med_warn(d2, rows),
            stem=stem,
            name_mode=name_mode,
        )),
        reply_markup=preview_kb(txt.pt_k, stem, name_mode),
    )
    await c.answer(f"Размер крестиков: {pt_label(txt.pt_k)}")


