UNDERLAY_DIR = Path("/home/workdir/artifacts/underlays")
UNDERLAY_DIR.mkdir(parents=True, exist_ok=True)
UNDERLAY_META = UNDERLAY_DIR / "slots.json"
UNDERLAY_SLOTS = (1, 2, 3, 4)


def _slot_path(n: int) -> Path:
    return UNDERLAY_DIR / f"slot{n}.dxf"


def _load_slot_meta() -> dict:
    if UNDERLAY_META.exists():
        try:
            import json
            return json.loads(UNDERLAY_META.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {}


def _save_slot_meta(meta: dict) -> None:
    import json
    UNDERLAY_META.write_text(
        json.dumps(meta, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )


def list_underlay_slots() -> Dict[int, dict]:
    """{1: {name, size_mb, path, saved}, ...} только заполненные."""
    meta = _load_slot_meta()
    out = {}
    for n in UNDERLAY_SLOTS:
        p = _slot_path(n)
        if p.exists() and p.stat().st_size > 0:
            info = meta.get(str(n), {})
            out[n] = {
                "name": info.get("name") or p.stem,
                "size_mb": p.stat().st_size / 1024 / 1024,
                "path": str(p),
                "saved": info.get("saved", ""),
            }
    return out


def save_underlay_slot(n: int, src: str, name: str = "") -> str:
    """Копирует DXF в ячейку n. Возвращает имя."""
    if n not in UNDERLAY_SLOTS:
        raise ValueError(f"Ячейка {n} недоступна (1..4)")
    dst = _slot_path(n)
    shutil.copy2(src, dst)
    meta = _load_slot_meta()
    base = safe_basename(name or Path(src).stem, f"slot{n}")
    meta[str(n)] = {
        "name": base,
        "saved": datetime.now().strftime("%Y-%m-%d %H:%M"),
    }
    _save_slot_meta(meta)
    return base


def load_underlay_slot(n: int, dest: str) -> str:
    """Копирует ячейку n в dest. Возвращает имя."""
    slots = list_underlay_slots()
    if n not in slots:
        raise FileNotFoundError(f"Ячейка {n} пуста")
    shutil.copy2(slots[n]["path"], dest)
    return slots[n]["name"]


def delete_underlay_slot(n: int) -> str:
    """Удаляет ячейку n. Возвращает имя удалённого или ''."""
    if n not in UNDERLAY_SLOTS:
        raise ValueError(f"Ячейка {n} недоступна (1..4)")
    p = _slot_path(n)
    meta = _load_slot_meta()
    name = meta.get(str(n), {}).get("name", p.stem)
    if p.exists():
        p.unlink()
    meta.pop(str(n), None)
    _save_slot_meta(meta)
    return name or ""


