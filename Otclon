# ─────────────────────── Выход: DXF ───────────────────────

def write_dxf(path, dxf, rows, flags, off, th, txt):
    doc = ezdxf.new("R2010")
    doc.header["$INSUNITS"] = 6
    doc.header["$MEASUREMENT"] = 1
    doc.header["$PDMODE"] = 3
    doc.header["$PDSIZE"] = off * 0.5 * txt.pt_k
    style = ensure_cyr_style(doc)

    for name, color in (("PROJ", 8), ("FACT", 5), ("DELTA", 1),
                        ("OVER", 6), ("TAG", 7), ("LEAD", 8)):
        if name not in doc.layers:
            doc.layers.add(name, color=color)
    msp = doc.modelspace()

    for pts, closed, _ in dxf.polylines:
        xy = [(p[0], p[1]) for p in pts]
        if closed and len(xy) > 2 and \
           math.hypot(xy[-1][0] - xy[0][0], xy[-1][1] - xy[0][1]) < 1e-9:
            xy = xy[:-1]
        msp.add_lwpolyline(xy, close=closed,
                           dxfattribs={"layer": "PROJ", "elevation": pts[0][2]})

    for r in rows:
        x, y = r["p"]; qx, qy = r["q"]
        lay = "OVER" if r["over"] else "DELTA"
        msp.add_point((x, y), dxfattribs={"layer": "FACT"})
        msp.add_circle((x, y), radius=off * 0.18 * txt.pt_k,
                       dxfattribs={"layer": "FACT"})
        if r["d_m"] > 1e-6:
            msp.add_line((x, y), (qx, qy), dxfattribs={"layer": lay})

    fs = min(th, off * 0.52)
    for f in flags:
        msp.add_line(f["anchor"], f["elbow"], dxfattribs={"layer": "LEAD"})
        msp.add_line(f["elbow"], f["polka"], dxfattribs={"layer": "LEAD"})
        x0, y0, w, h = f["box"]
        ch = f["ch"]; lw, iw, vw = f["cols"]; cnt = len(f["lines"])
        if txt.flagbox:
            msp.add_lwpolyline([(x0, y0), (x0 + w, y0),
                                (x0 + w, y0 + h), (x0, y0 + h)],
                               close=True, dxfattribs={"layer": "TAG"})
            for k in range(1, cnt):
                msp.add_line((x0, y0 + k * ch), (x0 + w, y0 + k * ch),
                             dxfattribs={"layer": "TAG"})
            for xx in (x0 + lw, x0 + lw + iw):
                msp.add_line((xx, y0), (xx, y0 + h),
                             dxfattribs={"layer": "TAG"})
        for k, (letter, pid, val, over) in enumerate(f["lines"]):
            yy = y0 + (cnt - 1 - k) * ch + ch * 0.24
            msp.add_text(letter, dxfattribs={
                "layer": "FACT", "style": style, "height": fs,
                "insert": (x0 + lw * 0.24, yy)})
            msp.add_text(pid, dxfattribs={
                "layer": "FACT", "style": style, "height": fs * 0.9,
                "insert": (x0 + lw + iw * 0.12, yy)})
            msp.add_text(val, dxfattribs={
                "layer": "OVER" if over else "DELTA", "style": style, "height": fs,
                "insert": (x0 + lw + iw + vw * 0.12, yy)})
    doc.saveas(path)


# ─────────────────── Сцена и тексты для бота ───────────────────

def load_inputs(data: dict, apply_swap: bool = True):
    """Одна точка входа: TXT + настройки FSM + (если решено) X↔Y + DXF."""
    txt = parse_txt(data["txt_path"])
    txt.shift = data.get("shift", txt.shift)
    txt.tol_mm = data.get("tol", txt.tol_mm)
    txt.level_tol = data.get("level_tol", txt.level_tol)
    txt.pair_r = data.get("pair_r", txt.pair_r)
    txt.pair_z = data.get("pair_z", txt.pair_z)
    txt.flagbox = data.get("flagbox", txt.flagbox)
    txt.dxfunits = data.get("dxfunits", txt.dxfunits)
    txt.pt_k = clamp_pt(data.get("pt_k", txt.pt_k))

    # МОДУЛЬ 0 решил → меняем ТОЛЬКО столбцы X/Y в TXT. H и SHIFT не трогаем.
    if apply_swap and data.get("swap_xy"):
        txt.points = [(pid, y, x, h) for pid, x, y, h in txt.points]

    dxf = parse_dxf(data["dxf_path"], txt.shift, txt.dxfunits, txt.level_tol)
    return txt, dxf


def build_scene(data: dict):
    txt, dxf = load_inputs(data)          # текущая (уже выбранная) ориентация
    rows = compute(txt, dxf)
    marks = assign_marks(rows, txt, dxf)
    off, th = geom_offset(dxf, rows)
    flags = make_flags(rows, txt, dxf, off)
    return txt, dxf, rows, off, th, flags, marks


def make_head(txt, dxf, rows, flags, marks, swapped=False, warn=""):
    npair = sum(1 for f in flags if f["pair"])
    head = [
        f"Готово. Точек *{len(rows)}*, флажков *{len(flags)}* "
        f"(пар В/Н — *{npair}*), полилиний *{len(dxf.polylines)}*, {dxf.scale_note}.",
        f"СК: *{'🔄 X↔Y применена' if swapped else 'без перестановки'}*, "
        "проверка модулем 0 пройдена.",
        f"*В/Н определены приложением*: пар по ΔH≥{txt.pair_z:.2f} м — "
        f"*{marks['pairs']}*, одиночных — *{marks['alone']}*. "
        f"Порог H = *{marks['thr']:+.3f}* ({marks['src']}). "
        "Вводить В/Н в TXT не требовалось.",
        f"Размер точек: *{pt_label(txt.pt_k)}* (DXF + PDF + PNG).",
        "Флажок по образцу ИС: `В │ № │ Δплан` сверху, `Н │ № │ Δплан` снизу, "
        "выноска в свободную сторону. **Только плановые смещения, мм.**",
        "`+` = слева по обходу полилинии, `−` = справа. `H` и `Z` участвуют "
        "только в выборе яруса/контура, в отклонение не входят.",
        "Цвета только здесь: серый — проект, синий — факт/буквы, красный — Δплан, "
        "малиновый — вне допуска. Легенды, штампа и рамки листа нет.",
        f"Кириллица: DXF-стиль `CYR` ({DXF_CYR_FONT}), глифы в PDF встроены.",
    ]
    if warn:
        head.insert(1, warn)
    if not dxf.has_z:
        head.append("ℹ️ В DXF нет разных `Z`: план меряется по всем полилиниям, "
                    "ярус взят из `H` TXT.")
    else:
        dzmed = statistics.median(r["dz"] for r in rows)
        if dzmed > max(1.0, txt.level_tol * 20):
            head.append(f"ℹ️ Разные системы высот (median ΔZ={dzmed:.2f} м): "
                        "взято ближайшее Z — на Δплан не влияет.")
    if any(r["mismatch"] for r in rows):
        head.append("ℹ️ Часть точек не попала в допуск яруса — взято ближайшее Z.")
    head.append("")
    for f in flags[:10]:
        lines = " / ".join(f"{a} {c} мм" for a, _, c, _ in f["lines"])
        bad = " ❗" if any(r["over"] for r in f["rows"]) else ""
        ids = "/".join(r["pid"] for r in f["rows"])
        head.append(f"`{ids}`  {lines}{bad}")
    if len(flags) > 10:
        head.append(f"… и ещё {len(flags) - 10} флажков — все на схеме в DXF/PDF.")
    return "\n".join(head)


