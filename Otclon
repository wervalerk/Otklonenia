@dp.message(Form.wait_dxf, F.document)
async def on_dxf(msg: types.Message, state: FSMContext):
    if not (msg.document.file_name or "").lower().endswith(".dxf"):
        await msg.answer(
            "Нужен файл `.dxf`.",
            parse_mode=ParseMode.MARKDOWN,
        )
        return

    fname = msg.document.file_name or "proj.dxf"
    data = await state.get_data()
    p = os.path.join(data["tmp"], "proj.dxf")

    declared = msg.document.file_size
    if declared and declared > DXF_MAX_BYTES:
        await msg.answer(
            f"⚠️ DXF слишком большой: *{human_mb(int(declared))}*.\n"
            f"Лимит — *{DXF_MAX_MB} МБ* ({DXF_MAX_BYTES:,} байт). "
