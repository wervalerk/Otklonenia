def _med_warn(data, rows) -> str:
    med = statistics.median(r["d_m"] for r in rows)
    if med > SHIFT_M and data.get("shift_checked"):
        return (f"⚠️ СК не рядом даже после `X0 Y0` (медиана {med:,.1f} м) — "
                "жмите *🔁 Перепроверить СК* или /start, чтобы повторить.")
    return ""


async def make_preview(msg: types.Message, state: FSMContext):
    data = await state.get_data()
    try:
        txt, dxf, rows, off, th, flags, marks = build_scene(data)
    except Exception as e:
        await msg.answer(f"Ошибка DXF: `{md_code(e)}`\nПришлите другой файл.",
                         parse_mode=ParseMode.MARKDOWN)
        await state.set_state(Form.wait_dxf)
        return

    med = statistics.median(r["d_m"] for r in rows)
    if med > SHIFT_M and not data.get("shift_checked"):
        await state.update_data(shift_checked=True, cs_done=False)
        await state.set_state(Form.wait_shift)
        await msg.answer(
            f"⚠️ После проверки СК медианное расстояние всё ещё *{med:,.1f} м* "
            f"(порог {SHIFT_M:.0f} м).\n"
            "Пришлите `X0 Y0` — привязку нуля DXF в осях DXF. "
            "НЕ авто-совмещаю по центроиду: оно обнулило бы само отклонение.",
            parse_mode=ParseMode.MARKDOWN, reply_markup=recheck_kb())
        return

    warn = _med_warn(data, rows)
    png = os.path.join(data["tmp"], "preview.png")
    write_png(png, dxf, rows, flags, txt)
    await state.update_data(out_png=png, pt_k=txt.pt_k)
    await state.set_state(Form.preview)
    await msg.answer_photo(
        FSInputFile(png),
        caption=preview_caption(txt, dxf, rows, flags, marks,
                                swapped=bool(data.get("swap_xy")), warn=warn),
        parse_mode=ParseMode.MARKDOWN, reply_markup=preview_kb(txt.pt_k))


async def rerender_preview(c: types.CallbackQuery, state: FSMContext, delta: float):
    data = await state.get_data()
    ptk = clamp_pt(data.get("pt_k", 1.0) + delta)
    await state.update_data(pt_k=ptk)
    try:
        txt, dxf, rows, off, th, flags, marks = build_scene(await state.get_data())
    except Exception as e:
        await c.answer(f"Ошибка: {md_code(e)}", show_alert=True)
        return
    png = os.path.join(data["tmp"], "preview.png")
    write_png(png, dxf, rows, flags, txt)
    await state.update_data(out_png=png)
    await c.message.edit_media(
        media=edit_photo(png, preview_caption(
            txt, dxf, rows, flags, marks,
            swapped=bool(data.get("swap_xy")), warn=_med_warn(data, rows))),
        reply_markup=preview_kb(txt.pt_k))
    await c.answer(f"Размер точек: {pt_label(txt.pt_k)}")


