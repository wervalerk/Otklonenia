# ─────────── МОДУЛЬ 0: запуск из бота ───────────

async def run_cs_check(msg: types.Message, state: FSMContext, force: bool = False):
    data = await state.get_data()
    if data.get("cs_done") and not force:
        return await make_preview(msg, state)

    tp, dpth = data.get("txt_path"), data.get("dxf_path")
    if not tp or not dpth or not os.path.exists(tp) or not os.path.exists(dpth):
        await msg.answer(
            "Файлы TXT/DXF не найдены — нажмите /start и пришлите заново.",
            parse_mode=ParseMode.MARKDOWN)
        await state.set_state(Form.wait_txt)
        return

    try:
        # проверяем ОТНОСИТЕЛЬНО ТЕКУЩЕЙ ориентации (swap_xy уже учтён)
        txt, dxf = load_inputs(data)
    except Exception as e:
        await msg.answer(
            f"Ошибка при проверке СК: `{md_code(e)}`\nПришлите другой DXF.",
            parse_mode=ParseMode.MARKDOWN)
        await state.set_state(Form.wait_dxf)
        return

    rep = check_cs(txt.points, dxf.segments, txt.shift)
    swapped = bool(data.get("swap_xy"))

    await msg.answer(
        cs_text(rep, txt.shift, swapped),
        parse_mode=ParseMode.MARKDOWN,
        reply_markup=None if rep.ok else cs_kb(swapped))

    if rep.ok:
        # ВАЖНО: swap_xy НЕ сбрасываем — иначе перестановка потеряется
        await state.update_data(cs_done=True, shift_checked=True)
        return await make_preview(msg, state)

    await state.update_data(cs_done=False)
    await state.set_state(Form.cs_check)


