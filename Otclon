@dp.callback_query(F.data == "pv_build")
async def pv_build(c: types.CallbackQuery, state: FSMContext):
    await c.answer("Собираю файлы…")
    data = await state.get_data()
    try:
        txt, dxf, rows, off, th, flags, marks = build_scene(data)
    except Exception as e:
        await c.message.answer(f"Ошибка: `{md_code(e)}`", parse_mode=ParseMode.MARKDOWN)
        return
    out_dxf = os.path.join(data["tmp"], "exec_plan.dxf")
    out_pdf = os.path.join(data["tmp"], "exec_plan.pdf")
    write_dxf(out_dxf, dxf, rows, flags, off, th, txt)
    write_pdf(out_pdf, dxf, rows, flags, txt)
    await state.update_data(out_dxf=out_dxf, out_pdf=out_pdf)
    await state.set_state(Form.ready)
    await c.message.answer(
        make_head(txt, dxf, rows, flags, marks,
                  swapped=bool(data.get("swap_xy")), warn=_med_warn(data, rows)),
        parse_mode=ParseMode.MARKDOWN)
    await c.message.answer_document(
        FSInputFile(out_dxf),
        caption=f"DXF: PROJ / FACT / DELTA / TAG / LEAD, метры, $INSUNITS=6, "
                f"стрелки Q→P, подписи ×{TEXT_SCALE:.0f} без рамки")
    await c.message.answer_document(
        FSInputFile(out_pdf),
        caption=f"PDF — `В +25` / `Н −20` ×{TEXT_SCALE:.0f} без рамки и номера, "
                f"зум в Telegram",
        reply_markup=final_kb())


@dp.callback_query(F.data.startswith("get_"))
async def on_get(c: types.CallbackQuery, state: FSMContext):
    keys = {"get_dxf": "out_dxf", "get_pdf": "out_pdf"}
    caps = {"get_dxf": "DXF ещё раз", "get_pdf": "PDF ещё раз"}
    p = (await state.get_data()).get(keys.get(c.data, ""))
    if not p or not os.path.exists(p):
        await c.answer("Файлы устарели, нажмите /start", show_alert=True)
        return
    await c.message.answer_document(FSInputFile(p), caption=caps[c.data])
    await c.answer()


