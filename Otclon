@dp.message(Form.wait_txt, F.document)
async def on_txt(msg: types.Message, state: FSMContext):
    if not (msg.document.file_name or "").lower().endswith(".txt"):
        await msg.answer("Нужен файл `.txt`.", parse_mode=ParseMode.MARKDOWN)
        return
    data = await state.get_data()
    p = os.path.join(data["tmp"], "points.txt")
    await download_doc(msg, p)
    try:
        txt = parse_txt(p)
    except Exception as e:
        await msg.answer(f"Ошибка TXT: `{md_code(e)}`", parse_mode=ParseMode.MARKDOWN)
        return

    # если # PTS в файле не задан — сохраняем размер, подобранный кнопками на образце
    pt_k = txt.pt_k if txt.pt_set else data.get("pt_k", txt.pt_k)
    hs = [t[3] for t in txt.points]

    await state.update_data(
        txt_path=p, shift=txt.shift, tol=txt.tol_mm,
        level_tol=txt.level_tol, pair_r=txt.pair_r, pair_z=txt.pair_z,
        flagbox=txt.flagbox, dxfunits=txt.dxfunits,
        pt_k=pt_k, shift_checked=False,
        swap_xy=False, cs_done=False)
    await state.set_state(Form.wait_dxf)

    await msg.answer(
        f"TXT принят: точек *{len(txt.points)}*, H от *{min(hs):.3f}* до "
        f"*{max(hs):.3f}*, допуск *{txt.tol_mm:.0f} мм*, PAIRZ *{txt.pair_z:.2f} м*, "
        f"точки *{pt_label(pt_k)}*.\n"
        "`В/Н` определю сам, а сначала после DXF проверю СК. Пришлите *DXF*.",
        parse_mode=ParseMode.MARKDOWN)


