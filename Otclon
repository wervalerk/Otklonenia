def cluster_levels(values, tol: float) -> List[float]:
    vals = sorted(v for v in values if math.isfinite(v))
    if not vals:
        return []
    groups = [[vals[0]]]
    for v in vals[1:]:
        if v - groups[-1][-1] <= tol:
            groups[-1].append(v)
        else:
            groups.append([v])
    return [sum(g) / len(g) for g in groups]


def pid_sort(r) -> tuple:
    p = r["pid"]
    return (0, int(p), "") if p.isdigit() else (1, 0, p)


def xy_groups(rows, radius: float):
    unused, out = list(rows), []
    while unused:
        seed = unused.pop(0)
        g, i = [seed], 0
        while i < len(unused):
            if math.hypot(
                unused[i]["p"][0] - seed["p"][0],
                unused[i]["p"][1] - seed["p"][1],
            ) <= radius:
                g.append(unused.pop(i))
            else:
                i += 1
        out.append(g)
    return out


def max_gap_threshold(hs: List[float]) -> float:
    v = sorted(hs)
    if len(v) < 2:
        return v[0] if v else 0.0
    return max(
        (v[i + 1] - v[i], (v[i + 1] + v[i]) / 2)
        for i in range(len(v) - 1)
    )[1]


def assign_marks(rows, txt: TxtData, dxf) -> dict:
    for r in rows:
        r.pop("pair_key", None)
        r.pop("mark", None)
        r["in_flag"] = False

    mids, npair = [], 0
    for gi, g in enumerate(xy_groups(rows, txt.pair_r)):
        g.sort(key=lambda r: r["h"])
        if len(g) >= 2 and (g[-1]["h"] - g[0]["h"]) >= txt.pair_z:
            lo, hi = g[0], g[-1]
            key = f"P{gi}"
            npair += 1
            lo["mark"], hi["mark"] = MARKS[0], MARKS[1]
            lo["pair_key"] = hi["pair_key"] = key
            lo["in_flag"] = hi["in_flag"] = True
            mids.append((lo["h"] + hi["h"]) / 2.0)
        else:
            min(g, key=pid_sort)["in_flag"] = True

    hs = [r["h"] for r in rows]
    if mids:
        thr, src = statistics.median(mids), "медиана середин пар"
    elif len(dxf.level_reps) >= 2:
        thr, src = sum(dxf.level_reps) / 2.0, "Z контуров DXF"
    else:
        thr, src = max_gap_threshold(hs), "макс. разрыв H"

    nalone = 0
    for r in rows:
        if "mark" not in r:
            r["mark"] = MARKS[1] if r["h"] >= thr else MARKS[0]
            r["pair_key"] = None
            nalone += 1
        if r["pid"] in txt.explicit:
            r["mark"] = txt.explicit[r["pid"]]
        r["lname"] = (
            f"{MARKS[0]} (низ) H {r['h']:+.3f}"
            if r["mark"] == MARKS[0]
            else f"{MARKS[1]} (верх) H {r['h']:+.3f}"
        )

    return {
        "thr": thr,
        "pairs": npair,
        "alone": nalone,
        "src": src,
    }


