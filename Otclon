def num(tok: str) -> float:
    return float(tok.strip().replace(",", "."))


HINT = {"ВЕРХ": "В", "НИЗ": "Н", "В": "В", "Н": "Н"}


@dataclass
class TxtData:
    points: List[Tuple[str, float, float, float]] = field(default_factory=list)
    shift: Tuple[float, float] = (0.0, 0.0)
    tol_mm: float = 10.0
    level_tol: float = 0.05
    pair_r: float = 0.30
    pair_z: float = 0.50
    dxfunits: Optional[str] = None
    explicit: Dict[str, str] = field(default_factory=dict)
    pt_k: float = 1.0
    pt_set: bool = False
    off: float = 0.05
    red_mm: float = RED_MM


def parse_txt(path: str) -> TxtData:
    points, shift, tol, lvl, dxfunits = [], (0.0, 0.0), 10.0, 0.05, None
    pair_r, pair_z, txt_units = 0.30, 0.50, "m"
    pt_k, pt_set, red_mm, explicit = 1.0, False, RED_MM, {}

    for raw in Path(path).read_text(
        encoding="utf-8-sig",
        errors="replace",
    ).splitlines():
        line = raw.strip()
        if not line:
            continue

        if line.startswith("#"):
            if re.match(r"#\s*(Hпр|HPRJ|HPROJ|H)\s*=", line, re.I):
                continue

            m = re.match(
                r"#\s*SHIFT\s*=\s*([+-]?[\d.,]+)[;\s]+([+-]?[\d.,]+)",
                line,
                re.I,
            )
            if m:
                shift = (num(m.group(1)), num(m.group(2)))
                continue

            m = re.match(r"#\s*TOL\s*=\s*([\d.,]+)", line, re.I)
            if m:
                tol = num(m.group(1))
                continue

            m = re.match(
                r"#\s*(?:LEVELTOL|LEVEL)\s*=\s*([\d.,]+)",
                line,
                re.I,
            )
            if m:
                lvl = num(m.group(1))
                continue

            m = re.match(r"#\s*PAIRR\s*=\s*([\d.,]+)", line, re.I)
            if m:
                pair_r = num(m.group(1))
                continue

            m = re.match(r"#\s*PAIRZ\s*=\s*([\d.,]+)", line, re.I)
            if m:
                pair_z = num(m.group(1))
                continue

            m = re.match(
                r"#\s*(?:REDLIM|REDMM|RED)\s*=\s*([\d.,]+)",
                line,
                re.I,
            )
            if m:
                red_mm = num(m.group(1))
                continue

            m = re.match(
                r"#\s*(?:PTS|PTK|PT|POINTSIZE)\s*=\s*([\d.,]+)",
                line,
                re.I,
            )
            if m:
                pt_k, pt_set = num(m.group(1)), True
                continue

            m = re.match(r"#\s*DXFUNITS\s*=\s*(mm|cm|m)\b", line, re.I)
            if m:
                dxfunits = m.group(1).lower()
                continue

            m = re.match(r"#\s*UNITS\s*=\s*(mm|m)\b", line, re.I)
            if m:
                txt_units = m.group(1).lower()
                continue

            continue

        line = line.split("#", 1)[0].strip()
        if not line:
            continue

        s = line.replace(";", " ").replace("\t", " ")

        if re.search(r"\s", s):
            s = re.sub(r"(?<=\d),(?=\d)", ".", s)
            s = s.replace(",", " ")
            toks = s.split()
        else:
            toks = s.split(",")

        fields = [t.strip() for t in toks if t.strip()]

        if len(fields) < 4:
            raise ValueError(
                f"Нужно минимум 4 поля (№ X Y H), получили {len(fields)}: {raw!r}"
            )

        if len(fields) >= 5 and re.fullmatch(
            r"[+-]?\d+(?:\.\d+)?",
            fields[4],
        ):
            raise ValueError(
                f"Похоже, 5-м полем оказалось число {fields[4]!r}: {raw!r}. "
                "Не разбивайте число пробелом и не пишите все координаты через запятые."
            )

        pid = fields[0]
        x, y, h = (num(v) for v in fields[1:4])

        if len(fields) >= 5:
            hint = HINT.get(fields[4].upper())
            if hint:
                explicit[pid] = hint

        m = re.match(r"^(.*?)[/_\-]?(В|Н)$", pid, re.I)
        if m and pid not in explicit:
            explicit[pid] = m.group(2).upper()

        k = 0.001 if txt_units == "mm" else 1.0
        points.append((pid, x * k, y * k, h * k))

    if not points:
        raise ValueError("В TXT нет ни одной точки.")

    return TxtData(
        points=points,
        shift=shift,
        tol_mm=tol,
        level_tol=lvl,
        pair_r=max(pair_r, 1e-6),
        pair_z=max(pair_z, 1e-6),
        dxfunits=dxfunits,
        explicit=explicit,
        pt_k=clamp_pt(pt_k),
        pt_set=pt_set,
        red_mm=max(red_mm, 0.0),
    )


