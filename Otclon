def safe_basename(s, fallback="exec_plan") -> str:
    s = str(s or "").strip()
    s = re.sub(r"[^\w\-. ]+", "_", s, flags=re.UNICODE)
    s = s.replace(" ", "_")
    s = re.sub(r"_+", "_", s).strip("._-")
    s = s[:64].strip("._-")
    return s or fallback


def auto_stem(data: dict) -> str:
    raw = data.get("txt_name") or data.get("dxf_name") or ""
    stem = safe_basename(Path(raw).stem if raw else "", "")
    if stem and stem.lower() not in ("points", "proj", "project", "plan"):
        return safe_basename(f"{stem}_exec_plan")
    return "exec_plan_" + datetime.now().strftime("%Y%m%d_%H%M%S")


def out_stem(data: dict) -> str:
    if data.get("name_mode") == "custom" and data.get("base_name"):
        return safe_basename(data["base_name"])
    return auto_stem(data)


def name_label(data: dict) -> str:
    return (
        "Авто"
        if data.get("name_mode", "auto") == "auto"
        else safe_basename(data.get("base_name", ""), "своё")
