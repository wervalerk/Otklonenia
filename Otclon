def build_scene(data: dict):
    """Пересобираем сцену из файлов + текущих настроек FSM."""
    txt = parse_txt(data["txt_path"])
    txt.shift = data.get("shift", txt.shift)
    txt.tol_mm = data.get("tol", txt.tol_mm)
    txt.level_tol = data.get("level_tol", txt.level_tol)
    txt.pair_r = data.get("pair_r", txt.pair_r)
    txt.flagbox = data.get("flagbox", txt.flagbox)
    txt.dxfunits = data.get("dxfunits", txt.dxfunits)
    txt.pt_k = clamp_pt(data.get("pt_k", txt.pt_k))     # ← кнопки перебивают TXT

    dxf = parse_dxf(data["dxf_path"], txt.shift, txt.dxfunits, txt.level_tol)
    rows, reps = compute(txt, dxf)
    off, th = geom_offset(dxf, rows)
    flags = make_flags(rows, txt, dxf, off)
    return txt, dxf, rows, reps, off, th, flags


def make_head(txt, dxf, rows, reps, flags):
    lv = ", ".join(f"{z:+.3f}" for z in reps) if reps else "не заданы"
    npair = sum(1 for f in flags if f["pair"])
    head = [
        f"Готово. Точек *{len(rows)}*, флажков *{len(flags)}* "
        f"(пар В/Н — *{npair}*), полилиний *{len(dxf.polylines)}*, {dxf.scale_note}.",
        f"Размер точек: *{pt_label(txt.pt_k)}* (применён и в DXF, и в PDF).",
        "На схеме флажок по образцу ИС: `В │ № │ Δплан` сверху, "
        "`Н │ № │ Δплан` снизу, выноска в свободную сторону от тела конструкции. "
        "**Только плановые смещения, мм.**",
        "`+` = слева по обходу полилинии (против часовой → внутрь), `−` = справа. "
        "`В/Н` задаёт ярус по `Z/H` и выбор контура, в отклонение не входит.",
        f"Яруса: {lv}. Цвета только здесь: серый — проект, синий — факт/буквы, "
        "красный — Δплан, малиновый — вне допуска. Легенды, штампа и рамки листа нет.",
        f"Кириллица: DXF-стиль `CYR` ({DXF_CYR_FONT}), глифы в PDF встроены.",
    ]
    if not dxf.has_z:
        head.append("ℹ️ В DXF нет разных `Z`: яруса взяты из `H` TXT, "
                    "план меряется по всем полилиниям.")
    else:
        dzmed = statistics.median(r["dz"] for r in rows)
        if dzmed > max(1.0, txt.level_tol * 20):
            head.append(f"ℹ️ Похоже, разные системы высот (median ΔZ={dzmed:.2f} м): "
                        "яруса сопоставлены по ближайшему Z — на Δплан не влияет.")
    if len(reps) <= 1 and not txt.explicit:
        head.append("ℹ️ Один ярус: всем присвоена `В`. Укажите `Н` явно для пары.")
    if any(r["mismatch"] for r in rows):
        head.append("ℹ️ Часть точек не попала в допуск яруса — взято ближайшее Z.")
    head.append("")
    for f in flags[:10]:
        lines = " / ".join(f"{a} {c} мм" for a, _, c, _ in f["lines"])
        bad = " ❗" if any(r["over"] for r in f["rows"]) else ""
        ids = "/".join(r["pid"] for r in f["rows"])
        head.append(f"`{ids}`  {lines}{bad}")
    if len(flags) > 10:
        head.append(f"… и ещё {len(flags) - 10} флажков — все на схеме в DXF/PDF.")
    return "\n".join(head)


