@dp.message(Form.wait_shift, F.text)
async def on_shift(msg: types.Message, state: FSMContext):
    m = re.match(r"^\s*([+-]?[\d.,]+)[;\s]+([+-]?[\d.,]+)\s*$", msg.text)
    if not m:
        await msg.answer("Два числа: `2860.000 9500.000`.",
                         parse_mode=ParseMode.MARKDOWN, reply_markup=recheck_kb())
        return
    await state.update_data(shift=(num(m.group(1)), num(m.group(2))),
                            shift_checked=True, cs_done=False)
    await run_cs_check(msg, state, force=True)


