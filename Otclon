SUPPORTED = {"LWPOLYLINE", "POLYLINE", "LINE", "ARC"}


def walk(entities, depth=0):
    for e in entities:
        if e.dxftype() == "INSERT" and depth < 3:
            try:
                yield from walk(e.virtual_entities(), depth + 1)
            except Exception:
                continue
        else:
            yield e


def manual_pts(e):
    t = e.dxftype()
    if t == "LWPOLYLINE":
        z = float(e.dxf.get("elevation", 0.0) or 0.0)
        return [(p[0], p[1], z) for p in e.get_points("xy")], bool(getattr(e, "closed", False))
    if t == "POLYLINE":
        return [(v.dxf.location.x, v.dxf.location.y, v.dxf.location.z)
                for v in e.vertices], bool(getattr(e, "is_closed", False))
    if t == "LINE":
        s, e2 = e.dxf.start, e.dxf.end
        return [(s.x, s.y, s.z), (e2.x, e2.y, e2.z)], False
    if t == "ARC":
        c, r = e.dxf.center, e.dxf.radius
        a0, a1 = e.dxf.start_angle, e.dxf.end_angle
        if a1 < a0:
            a1 += 360.0
        n = max(16, int((a1 - a0) / 5) + 1)
        return [(c.x + r * math.cos(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                 c.y + r * math.sin(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                 c.z) for i in range(n)], False
    return [], False


def raw_path(e):
    if e.dxftype() not in SUPPORTED:
        return None
    try:
        ext = bbox.extents([e])
        local = max(abs(ext.extmin.x), abs(ext.extmin.y),
                    abs(ext.extmax.x), abs(ext.extmax.y))
    except Exception:
        local = 1000.0
    flat = max(local * 2e-4, 1e-3)
    try:
        p = make_path(e)
        pts = [(v.x, v.y, v.z) for v in p.flattening(flat)]
        closed = bool(getattr(p, "is_closed", False))
    except Exception:
        pts, closed = manual_pts(e)
    closed = closed or bool(getattr(e, "closed", False)) or bool(getattr(e, "is_closed", False))
    if len(pts) < 2:
        return None
    if closed and math.hypot(pts[-1][0] - pts[0][0], pts[-1][1] - pts[0][1]) > 1e-9:
        pts.append(pts[0])
    return {"pts": pts, "closed": closed, "layer": e.dxf.layer}


def choose_scale(doc, maxabs, override):
    if override:
        return {"m": 1.0, "cm": 0.01, "mm": 0.001}[override], f"DXFUNITS={override} (из TXT)"
    u = int(doc.header.get("$INSUNITS", 0) or 0)
    tbl = {1: 0.0254, 2: 0.3048, 4: 0.001, 5: 0.01,
           6: 1.0, 7: 1000.0, 10: 0.9144}
    if u in tbl:
        return tbl[u], f"$INSUNITS={u}"
    if maxabs > 1000.0:
        return 0.001, "$INSUNITS=0 → принял мм"
    return 1.0, "$INSUNITS=0 → принял м"


def parse_dxf(path, shift, dxfunits_override, level_tol) -> DxfData:
    doc = ezdxf.readfile(path)
    raw = [r for r in (raw_path(e) for e in walk(doc.modelspace())) if r]
    if not raw:
        raise ValueError("Не найдено LWPOLYLINE / POLYLINE / LINE / ARC (в т.ч. в блоках).")

    coords = [v for r in raw for p in r["pts"] for v in (p[0], p[1])]
    scale, note = choose_scale(doc, max(abs(v) for v in coords), dxfunits_override)

    dx, dy = shift
    polylines, segments, contour_z = [], [], []
    for r in raw:
        pts_m = [(x * scale + dx, y * scale + dy, z * scale)
                 for x, y, z in r["pts"]]
        contour_z.append(sum(p[2] for p in pts_m) / len(pts_m))
        polylines.append((pts_m, r["closed"], r["layer"]))
        for a, b in zip(pts_m, pts_m[1:]):
            if (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2 < 1e-18:
                continue
            segments.append(Seg(*a, *b, r["layer"]))

    if not segments:
        raise ValueError("После приведения единиц не осталось отрезков.")
    distinct = {round(z, 3) for z in contour_z}
    has_z = len(distinct) > 1 or any(abs(z) > 1e-9 for z in contour_z)
    reps = cluster_levels(contour_z, level_tol) if has_z else []
    return DxfData(polylines, segments, note, has_z, reps)


# ─────────────── Расчёт ТОЛЬКО плановых смещений ───────────────

def compute(txt: TxtData, dxf: DxfData):
    rows = []
    for pid, x, y, h in txt.points:
        same, other = [], []
        for si, s in enumerate(dxf.segments):
            vx, vy = s.bx - s.ax, s.by - s.ay
            t = ((x - s.ax) * vx + (y - s.ay) * vy) / (vx * vx + vy * vy)
            t = 0.0 if t < 0 else (1.0 if t > 1 else t)

            qx, qy = s.ax + t * vx, s.ay + t * vy
            qz = s.az + t * (s.bz - s.az)
            d = math.hypot(x - qx, y - qy)
            cross = vx * (y - s.ay) - vy * (x - s.ax)
            dp = (1.0 if cross >= 0 else -1.0) * d * 1000.0

            c = {"d": d, "dp": dp, "qx": qx, "qy": qy,
                 "qz": qz, "dz": abs(qz - h), "layer": s.layer, "si": si}
            if not dxf.has_z or c["dz"] <= txt.level_tol:
                same.append(c)
            else:
                other.append(c)

        if not same and other:
            zmin = min(c["dz"] for c in other)
            same = [c for c in other if c["dz"] <= zmin + txt.level_tol]

        best = min(same or other, key=lambda c: c["d"])
        mismatch = bool(dxf.has_z and other and not any(
            c["dz"] <= txt.level_tol for c in (same + other)))
        dp = 0.0 if abs(best["dp"]) < 0.5 else best["dp"]

        rows.append({
            "pid": pid, "p": (x, y), "q": (best["qx"], best["qy"]),
            "h": h, "qz": best["qz"], "dz": best["dz"],
            "d_m": best["d"], "dp": dp, "layer": best["layer"],
            "si": best["si"],
            "over": abs(dp) > txt.tol_mm,          # ← только план
            "mismatch": mismatch,
        })
    return rows


def geom_offset(dxf, rows):
    xs = [p[0] for r in rows for p in (r["p"], r["q"])]
    ys = [p[1] for r in rows for p in (r["p"], r["q"])]
    for pts, _, _ in dxf.polylines:
        xs += [p[0] for p in pts]
        ys += [p[1] for p in pts]
    span = max(max(xs) - min(xs), max(ys) - min(ys), 1e-6)
    off = min(max(span * 0.006, 0.04), 0.6)
    return off, off * 0.65


# ─────────── Флажки «В │ № │ Δ» / «Н │ № │ Δ» ───────────

def _centroid(dxf):
    xs = [p[0] for pts, _, _ in dxf.polylines for p in pts]
    ys = [p[1] for pts, _, _ in dxf.polylines for p in pts]
    return (sum(xs) / len(xs), sum(ys) / len(ys)) if xs else (0.0, 0.0)


def leader_dir(rows_subset, dxf):
    vx = vy = 0.0
    for r in rows_subset:
        vx += r["p"][0] - r["q"][0]
        vy += r["p"][1] - r["q"][1]
    L = math.hypot(vx, vy)
    if L > 1e-6:
        return vx / L, vy / L
    s = dxf.segments[rows_subset[0]["si"]]
    ex, ey = s.bx - s.ax, s.by - s.ay
    el = math.hypot(ex, ey) or 1.0
    nx, ny = -ey / el, ex / el
    cx, cy = _centroid(dxf)
    px, py = rows_subset[0]["p"]
    if (px - cx) * nx + (py - cy) * ny < 0:
        nx, ny = -nx, -ny
    return nx, ny


def make_flags(rows, txt, dxf, off):
    groups: Dict[object, List[dict]] = {}
    for i, r in enumerate(rows):
        key = r.get("pair_key") or ("one", i)
        groups.setdefault(key, []).append(r)

    raw: List[List[dict]] = []
    for g in groups.values():
        ups = sorted([r for r in g if r["mark"] == MARKS[1]], key=pid_sort)
        dns = sorted([r for r in g if r["mark"] == MARKS[0]], key=pid_sort)
        rest = [r for r in g if r["mark"] not in MARKS]
        used = set()
        for u in ups:
            cand = min((d for d in dns if d["pid"] not in used),
                       key=lambda d: math.hypot(d["p"][0] - u["p"][0],
                                                d["p"][1] - u["p"][1]),
                       default=None)
            raw.append([u, cand] if cand else [u])
            if cand:
                used.add(cand["pid"])
        raw += [[d] for d in dns if d["pid"] not in used]
        raw += [[r] for r in rest]

    ch = off * 0.85
    lw, iw, vw = ch * 0.95, ch * 2.0, ch * 2.2
    w = lw + iw + vw
    lead, diag = off * 1.7, off * 0.9

    occupied, flags = [], []
    for item in raw:
        up = next((r for r in item if r["mark"] == MARKS[1]), None)
        dn = next((r for r in item if r["mark"] == MARKS[0]), None)
        ordered = [r for r in (up, dn) if r] or item        # В сверху, Н снизу

        anchor = (sum(r["p"][0] for r in ordered) / len(ordered),
                  sum(r["p"][1] for r in ordered) / len(ordered))
        nx, ny = leader_dir(ordered, dxf)
        ex, ey = anchor[0] + nx * diag, anchor[1] + ny * diag
        x0 = ex + nx * (lead - diag) - (w if nx < 0 else 0)
        h = ch * len(ordered)
        y0_base = ey + ny * (lead - diag) * 0.35 - h / 2
        y0 = y0_base

        for k in range(10):
            box = (x0, y0, w, h)
            hit = any(not (box[0] + w < b[0] or b[0] + b[2] < box[0] or
                           box[1] + h < b[1] or b[1] + b[3] < box[1])
                      for b in occupied)
            if not hit:
                break
            step = (h + ch * 0.35) * (k // 2 + 1)
            y0 = y0_base + (step if k % 2 == 0 else -step)
        occupied.append((x0, y0, w, h))

        flags.append({
            "rows": ordered, "anchor": anchor, "elbow": (ex, ey),
            "polka": ((x0 if nx >= 0 else x0 + w), y0 + h / 2),
            "box": (x0, y0, w, h), "ch": ch,
            "cols": (lw, iw, vw),
            "lines": [(r["mark"] or "·", r["pid"], f"{r['dp']:+.0f}", r["over"])
                      for r in ordered],
            "pair": len(ordered) > 1,
        })
    return flags


# ─────────── Общая отрисовка: образец / PNG / PDF ───────────

def _new_fig():
    fig, ax = plt.subplots(figsize=(11.7, 8.3))
    fig.subplots_adjust(0, 0, 1, 1)
    return fig, ax


def render_scene(ax, dxf, rows, flags, txt):
    fp = cyr_fp()
    ptk = txt.pt_k

    for pts, _, _ in dxf.polylines:
        ax.plot([p[0] for p in pts], [p[1] for p in pts],
                color="#9aa0a6", lw=0.8, zorder=1)

    for r in rows:
        x, y = r["p"]; qx, qy = r["q"]
        col = "#c2185b" if r["over"] else "#d93025"
        mk = ("^" if r["mark"] == MARKS[1] else
              "v" if r["mark"] == MARKS[0] else "o")
        ax.plot([x, qx], [y, qy], color=col, lw=0.7, zorder=2)
        ax.scatter([x], [y], s=20 * ptk, color="#1a73e8", marker=mk,
                   zorder=3, edgecolors="none")

    for f in flags:
        ax.plot([f["anchor"][0], f["elbow"][0]],
                [f["anchor"][1], f["elbow"][1]],
                color="#5f6368", lw=0.5, zorder=4)
        ax.plot([f["elbow"][0], f["polka"][0]],
                [f["elbow"][1], f["polka"][1]],
                color="#5f6368", lw=0.5, zorder=4)

        x0, y0, w, h = f["box"]
        ch = f["ch"]; lw, iw, vw = f["cols"]; cnt = len(f["lines"])
        if txt.flagbox:
            ax.add_patch(Rectangle((x0, y0), w, h, fill=False,
                                   ec="#5f6368", lw=0.55, zorder=5))
            for k in range(1, cnt):
                ax.plot([x0, x0 + w], [y0 + k * ch, y0 + k * ch],
                        color="#5f6368", lw=0.45, zorder=5)
            for xx in (x0 + lw, x0 + lw + iw):
                ax.plot([xx, xx], [y0, y0 + h],
                        color="#5f6368", lw=0.45, zorder=5)

        for k, (letter, pid, val, over) in enumerate(f["lines"]):
            yy = y0 + (cnt - 1 - k) * ch + ch * 0.26
            ax.text(x0 + lw * 0.24, yy, letter, color="#1a73e8",
                    fontsize=6, fontproperties=fp, zorder=6)
            ax.text(x0 + lw + iw * 0.12, yy, pid, color="#1a73e8",
                    fontsize=5.5, fontproperties=fp, zorder=6)
            ax.text(x0 + lw + iw + vw * 0.12, yy, val,
                    color="#c2185b" if over else "#d93025",
                    fontsize=6, fontproperties=fp, zorder=6)

    ax.relim(); ax.autoscale_view()
    ax.set_aspect("equal", adjustable="datalim")
    ax.set_axis_off()


def _save(fig, path, fmt, dpi=170):
    fig.savefig(path, format=fmt, bbox_inches="tight",
                pad_inches=0.02, facecolor="white", dpi=dpi)
    plt.close(fig)


def write_png(path, dxf, rows, flags, txt, dpi=170):
    fig, ax = _new_fig()
    render_scene(ax, dxf, rows, flags, txt)
    _save(fig, path, "png", dpi)


def write_pdf(path, dxf, rows, flags, txt):
    fig, ax = _new_fig()
    render_scene(ax, dxf, rows, flags, txt)
    _save(fig, path, "pdf")


def sample_scene(pt_k: float):
    """Образец идёт через ТУ ЖЕ авто-логику assign_marks(), без ручных В/Н."""
    pts = [(0.0, 0.0, 0.0), (3.0, 0.0, 0.0),
           (3.0, 0.30, 0.0), (0.0, 0.30, 0.0)]
    loop = pts + [pts[0]]
    segs = [Seg(*pts[i], *pts[i + 1], "PROJ") for i in range(3)]
    segs.append(Seg(0.0, 0.30, 0.0, 0.0, 0.0, 0.0, "PROJ"))
    dxf = DxfData([(loop, True, "PROJ")], segs, "образец", False, [])

    rows = [
        {"pid": "1", "p": (1.50, 0.325), "q": (1.50, 0.30),
         "d_m": 0.025, "dp": 25.0, "h": 170.4933,
         "over": True, "si": 2, "mismatch": False},
        {"pid": "2", "p": (1.50, -0.015), "q": (1.50, 0.0),
