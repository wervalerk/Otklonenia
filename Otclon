# ─────────────────────────── TXT ───────────────────────────

def num(tok: str) -> float:
    return float(tok.strip().replace(",", "."))


@dataclass
class TxtData:
    points: List[Tuple[str, float, float, float]]   # №, X, Y, H(м) — H ТОЛЬКО для яруса
    shift: Tuple[float, float] = (0.0, 0.0)         # привязка нуля DXF → СК TXT
    tol_mm: float = 10.0                            # допуск ТОЛЬКО по плану
    level_tol: float = 0.05                         # один ярус, м
    dxfunits: Optional[str] = None
    pair_r: float = 0.30                            # радиус пары В↔Н, м
    flagbox: bool = True                            # прямоугольничек флажка
    explicit: Dict[str, str] = field(default_factory=dict)   # pid -> "В"/"Н"
    pair_key: Dict[str, str] = field(default_factory=dict)   # pid -> ключ пары
    pt_k: float = 1.0                               # ← множитель размера точек


def parse_txt(path: str) -> TxtData:
    points, shift, tol, lvl, dxfunits = [], (0.0, 0.0), 10.0, 0.05, None
    pair_r, flagbox, txt_units, pt_k = 0.30, True, "m", 1.0
    explicit: Dict[str, str] = {}
    pair_key: Dict[str, str] = {}

    for raw in Path(path).read_text(encoding="utf-8-sig", errors="replace").splitlines():
        line = raw.strip()
        if not line:
            continue

        # ── строки настроек ──────────────────────────────────────────
        if line.startswith("#"):
            # совместимость со старыми файлами: Hпр больше не используется
            if re.match(r"#\s*(Hпр|HPRJ|HPROJ|H)\s*=", line, re.I):
                continue

            # между двумя числами: пробел / таб / ';' (НЕ запятая — она десятичная)
            m = re.match(r"#\s*SHIFT\s*=\s*([+-]?[\d.,]+)[;\s]+([+-]?[\d.,]+)", line, re.I)
            if m:
                shift = (num(m.group(1)), num(m.group(2))); continue

            m = re.match(r"#\s*TOL\s*=\s*([\d.,]+)", line, re.I)
            if m:
                tol = num(m.group(1)); continue

            m = re.match(r"#\s*(?:LEVELTOL|LEVEL)\s*=\s*([\d.,]+)", line, re.I)
            if m:
                lvl = num(m.group(1)); continue

            m = re.match(r"#\s*PAIRR\s*=\s*([\d.,]+)", line, re.I)
            if m:
                pair_r = num(m.group(1)); continue

            m = re.match(r"#\s*(?:PTS|PTK|PT|POINTSIZE)\s*=\s*([\d.,]+)", line, re.I)
            if m:
                pt_k = num(m.group(1)); continue

            m = re.match(r"#\s*FLAGBOX\s*=\s*(0|1|off|on)", line, re.I)
            if m:
                flagbox = m.group(1).lower() in ("1", "on"); continue

            m = re.match(r"#\s*DXFUNITS\s*=\s*(mm|cm|m)\b", line, re.I)
            if m:
                dxfunits = m.group(1).lower(); continue

            m = re.match(r"#\s*UNITS\s*=\s*(mm|m)\b", line, re.I)
            if m:
                txt_units = m.group(1).lower(); continue
            continue

        # ── строка точки ─────────────────────────────────────────────
        # inline-комментарий:  T9В 1251.800 431.905 -3.000 В # заметка
        line = line.split("#", 1)[0].strip()
        if not line:
            continue

        s = line.replace(";", " ").replace("\t", " ")

        if re.search(r"\s", s):
            # ЕСТЬ пробелы → запятая между ЦИФРАМИ = десятичная,
            # все остальные запятые = разделители полей.
            s = re.sub(r"(?<=\d),(?=\d)", ".", s)     # 1250,120 → 1250.120
            s = s.replace(",", " ")                    # T7, → T7
            parts = s.split()
        else:
            # ЧИСТЫЙ CSV, ни одного пробела → запятая = разделитель
            parts = [p for p in s.split(",") if p.strip()]

        if len(parts) not in (4, 5):
            raise ValueError(
                f"Ожидаю 4 или 5 полей (№ X Y H [В/Н]), получили {len(parts)}: {raw!r}. "
                "Не смешивайте запятую-разделитель с десятичной запятой — используйте ';'."
            )

        pid = parts[0]
        x, y, h = (num(v) for v in parts[1:4])

        # суффикс в номере: T9В, T9/Н, T9-В, T9_Н
        base = pid
        mk = None
        m = re.match(r"^(.*?)[/_\-]?(В|Н)$", pid, re.I)
        if m:
            base, mk = m.group(1), m.group(2).upper()

        # 5-й столбец — СТРОГО ярус; заметки только после '#'
        if len(parts) == 5:
            col = parts[4].strip().upper()
            mk5 = {"ВЕРХ": "В", "НИЗ": "Н", "В": "В", "Н": "Н"}.get(col)
            if mk5 is None:
                raise ValueError(
                    f"5-е поле должно быть В/Н/ВЕРХ/НИЗ, получили {parts[4]!r}: {raw!r}. "
                    "Заметки пишите после '#'."
                )
            mk = mk5                      # явный столбец перебиваетSuffix

        if mk:
            explicit[pid] = mk
            pair_key[pid] = base          # T9В и T9Н → одна пара "T9"

        k = 0.001 if txt_units == "mm" else 1.0
        points.append((pid, x * k, y * k, h * k))

    if not points:
        raise ValueError("В TXT нет ни одной точки.")
    return TxtData(
        points=points, shift=shift, tol_mm=tol, level_tol=lvl,
        dxfunits=dxfunits, pair_r=max(pair_r, 1e-6), flagbox=flagbox,
        explicit=explicit, pair_key=pair_key, pt_k=clamp_pt(pt_k),
    )


# ─────────────────────────── Яруса ───────────────────────────

def cluster_levels(values, tol: float) -> List[float]:
    vals = sorted(v for v in values if math.isfinite(v))
    if not vals:
        return []
    groups = [[vals[0]]]
    for v in vals[1:]:
        if v - groups[-1][-1] <= tol:
            groups[-1].append(v)
        else:
            groups.append([v])
    return [sum(g) / len(g) for g in groups]


def level_mark(i: int, n: int) -> str:
    """В / Н на схеме. При одном ярусе считаем верхом (пару задают явно)."""
    if n <= 1:
        return MARKS[1]                  # В
    if i == 0:
        return MARKS[0]                  # Н
    if i == n - 1:
        return MARKS[1]                  # В
    return str(i + 1)


def level_name(i: int, n: int, rep: float) -> str:
    if n <= 1:
        return f"{MARKS[1]} (верх) {rep:+.3f}"
    tag = (MARKS[0] + " (низ)" if i == 0 else
           MARKS[1] + " (верх)" if i == n - 1 else
           f"Я{i + 1}")
    return f"{tag} {rep:+.3f}"


# ─────────────────────────── DXF ───────────────────────────

@dataclass
class Seg:
    ax: float; ay: float; az: float
    bx: float; by: float; bz: float
    layer: str


@dataclass
class DxfData:
    polylines: List[Tuple[List[Tuple[float, float, float]], bool, str]]
    segments: List[Seg]
    scale_note: str
    has_z: bool
    level_reps: List[float]


SUPPORTED = {"LWPOLYLINE", "POLYLINE", "LINE", "ARC"}


def walk(entities, depth=0):
    """Разворачиваем INSERT — в КЖ колонны часто блоками."""
    for e in entities:
        if e.dxftype() == "INSERT" and depth < 3:
            try:
                yield from walk(e.virtual_entities(), depth + 1)
            except Exception:
                continue
        else:
            yield e


def manual_pts(e):
    t = e.dxftype()
    if t == "LWPOLYLINE":
        z = float(e.dxf.get("elevation", 0.0) or 0.0)       # код 38
        return [(p[0], p[1], z) for p in e.get_points("xy")], bool(getattr(e, "closed", False))
    if t == "POLYLINE":
        return [(v.dxf.location.x, v.dxf.location.y, v.dxf.location.z)
                for v in e.vertices], bool(getattr(e, "is_closed", False))
    if t == "LINE":
        s, e2 = e.dxf.start, e.dxf.end
        return [(s.x, s.y, s.z), (e2.x, e2.y, e2.z)], False
    if t == "ARC":
        c, r = e.dxf.center, e.dxf.radius
        a0, a1 = e.dxf.start_angle, e.dxf.end_angle
        if a1 < a0:
            a1 += 360.0
        n = max(16, int((a1 - a0) / 5) + 1)
        return [(c.x + r * math.cos(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                 c.y + r * math.sin(math.radians(a0 + (a1 - a0) * i / (n - 1))),
                 c.z) for i in range(n)], False
    return [], False


def raw_path(e):
    if e.dxftype() not in SUPPORTED:
        return None
    try:
        ext = bbox.extents([e])
        local = max(abs(ext.extmin.x), abs(ext.extmin.y),
                    abs(ext.extmax.x), abs(ext.extmax.y))
    except Exception:
        local = 1000.0
    flat = max(local * 2e-4, 1e-3)          # сглаживание bulge / дуг

    try:
        p = make_path(e)
        pts = [(v.x, v.y, v.z) for v in p.flattening(flat)]
        closed = bool(getattr(p, "is_closed", False))
    except Exception:
        pts, closed = manual_pts(e)

    closed = closed or bool(getattr(e, "closed", False)) or bool(getattr(e, "is_closed", False))
    if len(pts) < 2:
        return None
    if closed and math.hypot(pts[-1][0] - pts[0][0], pts[-1][1] - pts[0][1]) > 1e-9:
        pts.append(pts[0])
    return {"pts": pts, "closed": closed, "layer": e.dxf.layer}


def choose_scale(doc, maxabs, override):
    if override:
        return {"m": 1.0, "cm": 0.01, "mm": 0.001}[override], f"DXFUNITS={override} (из TXT)"
    u = int(doc.header.get("$INSUNITS", 0) or 0)
    tbl = {1: 0.0254, 2: 0.3048, 4: 0.001, 5: 0.01,
           6: 1.0, 7: 1000.0, 10: 0.9144}
    if u in tbl:
        return tbl[u], f"$INSUNITS={u}"
    if maxabs > 1000.0:
        return 0.001, "$INSUNITS=0 → принял мм"
    return 1.0, "$INSUNITS=0 → принял м"


def parse_dxf(path, shift, dxfunits_override, level_tol) -> DxfData:
    doc = ezdxf.readfile(path)
    raw = [r for r in (raw_path(e) for e in walk(doc.modelspace())) if r]
    if not raw:
        raise ValueError("Не найдено LWPOLYLINE / POLYLINE / LINE / ARC (в т.ч. в блоках).")

    coords = [v for r in raw for p in r["pts"] for v in (p[0], p[1])]
    scale, note = choose_scale(doc, max(abs(v) for v in coords), dxfunits_override)

    dx, dy = shift
    polylines, segments, contour_z = [], [], []

    for r in raw:
        pts_m = [(x * scale + dx, y * scale + dy, z * scale)
                 for x, y, z in r["pts"]]
        contour_z.append(sum(p[2] for p in pts_m) / len(pts_m))
        polylines.append((pts_m, r["closed"], r["layer"]))

        for a, b in zip(pts_m, pts_m[1:]):
            if (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2 < 1e-18:
                continue
            segments.append(Seg(*a, *b, r["layer"]))

    if not segments:
        raise ValueError("После приведения единиц не осталось отрезков.")

    distinct = {round(z, 3) for z in contour_z}
    has_z = len(distinct) > 1 or any(abs(z) > 1e-9 for z in contour_z)
    reps = cluster_levels(contour_z, level_tol) if has_z else []

    return DxfData(polylines, segments, note, has_z, reps)


# ─────────────── Расчёт ТОЛЬКО плановых смещений ───────────────

def compute(txt: TxtData, dxf: DxfData):
    reps = dxf.level_reps or cluster_levels([h for *_, h in txt.points], txt.level_tol)
    n = len(reps)

    rows = []
    for pid, x, y, h in txt.points:
        li = min(range(n), key=lambda i: abs(reps[i] - h)) if n else 0

        same, other = [], []
        for si, s in enumerate(dxf.segments):
            vx, vy = s.bx - s.ax, s.by - s.ay
            t = ((x - s.ax) * vx + (y - s.ay) * vy) / (vx * vx + vy * vy)
            t = 0.0 if t < 0 else (1.0 if t > 1 else t)      # проекция НА отрезок

            qx, qy = s.ax + t * vx, s.ay + t * vy
            qz = s.az + t * (s.bz - s.az)                     # Z контура в точке Q
            d = math.hypot(x - qx, y - qy)
            cross = vx * (y - s.ay) - vy * (x - s.ax)
            dp = (1.0 if cross >= 0 else -1.0) * d * 1000.0   # Δплан, мм

            c = {"d": d, "dp": dp, "qx": qx, "qy": qy,
                 "qz": qz, "dz": abs(qz - h), "layer": s.layer, "si": si}

            if not dxf.has_z:
                same.append(c)
            elif c["dz"] <= txt.level_tol:
                same.append(c)
            else:
                other.append(c)

        if not same and other:
            zmin = min(c["dz"] for c in other)
            same = [c for c in other if c["dz"] <= zmin + txt.level_tol]

        best = min(same or other, key=lambda c: c["d"])
        mismatch = bool(dxf.has_z and other and not any(
            c["dz"] <= txt.level_tol for c in (same + other)))

        dp = 0.0 if abs(best["dp"]) < 0.5 else best["dp"]

        rows.append({
            "pid": pid, "p": (x, y), "q": (best["qx"], best["qy"]),
            "h": h, "qz": best["qz"], "dz": best["dz"],
            "d_m": best["d"], "dp": dp, "layer": best["layer"],
            "si": best["si"],
            "mark": txt.explicit.get(pid) or level_mark(li, n),
            "lname": level_name(li, n, reps[li] if n else h),
            "over": abs(dp) > txt.tol_mm,                     # ← только план
            "mismatch": mismatch,
        })
    return rows, reps


def geom_offset(dxf, rows):
    xs = [p[0] for r in rows for p in (r["p"], r["q"])]
    ys = [p[1] for r in rows for p in (r["p"], r["q"])]
    for pts, _, _ in dxf.polylines:
        xs += [p[0] for p in pts]
        ys += [p[1] for p in pts]
    span = max(max(xs) - min(xs), max(ys) - min(ys), 1e-6)
    off = min(max(span * 0.006, 0.04), 0.6)
    return off, off * 0.65


# ─────────── Флажки «В │ № │ Δ» / «Н │ № │ Δ» по образцу ИС ───────────

def _centroid(dxf):
    xs = [p[0] for pts, _, _ in dxf.polylines for p in pts]
    ys = [p[1] for pts, _, _ in dxf.polylines for p in pts]
    return (sum(xs) / len(xs), sum(ys) / len(ys)) if xs else (0.0, 0.0)


def leader_dir(rows_subset, dxf):
    """Нормаль ОТ тела конструкции в свободную сторону."""
    vx = vy = 0.0
    for r in rows_subset:
        vx += r["p"][0] - r["q"][0]
        vy += r["p"][1] - r["q"][1]
    L = math.hypot(vx, vy)
    if L > 1e-6:
        return vx / L, vy / L

    s = dxf.segments[rows_subset[0]["si"]]
    ex, ey = s.bx - s.ax, s.by - s.ay
    el = math.hypot(ex, ey) or 1.0
    nx, ny = -ey / el, ex / el
    cx, cy = _centroid(dxf)
    px, py = rows_subset[0]["p"]
    if (px - cx) * nx + (py - cy) * ny < 0:
        nx, ny = -nx, -ny
    return nx, ny


def make_flags(rows, txt, dxf, off):
    """Один флажок на грань: В сверху, Н снизу, выноска в пустоту."""
    groups: Dict[object, List[dict]] = {}
    for r in rows:
        key = txt.pair_key.get(r["pid"])
        if key is None:
            key = (round(r["p"][0] / txt.pair_r),
                   round(r["p"][1] / txt.pair_r))     # только XY, не si!
        groups.setdefault(key, []).append(r)

    raw: List[List[dict]] = []
    for g in groups.values():
        ups = sorted([r for r in g if r["mark"] == MARKS[1]], key=lambda r: r["pid"])
        dns = sorted([r for r in g if r["mark"] == MARKS[0]], key=lambda r: r["pid"])
        rest = [r for r in g if r["mark"] not in MARKS]

        used = set()
        for u in ups:                                   # жадный подбор В → ближайший Н
            cand = min((d for d in dns if d["pid"] not in used),
                       key=lambda d: math.hypot(d["p"][0] - u["p"][0],
                                                d["p"][1] - u["p"][1]),
                       default=None)
            raw.append([u, cand] if cand else [u])
            if cand:
                used.add(cand["pid"])
        raw += [[d] for d in dns if d["pid"] not in used]
        raw += [[r] for r in rest]

    ch = off * 0.85                    # высота строки
    lw, iw, vw = ch * 0.95, ch * 2.0, ch * 2.2
    w = lw + iw + vw
    lead, diag = off * 1.7, off * 0.9

    occupied, flags = [], []
    for item in raw:
        up = next((r for r in item if r["mark"] == MARKS[1]), None)
        dn = next((r for r in item if r["mark"] == MARKS[0]), None)
        ordered = [r for r in (up, dn) if r] or item        # В сверху, Н снизу

        anchor = (sum(r["p"][0] for r in ordered) / len(ordered),
                  sum(r["p"][1] for r in ordered) / len(ordered))
        nx, ny = leader_dir(ordered, dxf)

        ex, ey = anchor[0] + nx * diag, anchor[1] + ny * diag
        x0 = ex + nx * (lead - diag) - (w if nx < 0 else 0)
        h = ch * len(ordered)
        y0_base = ey + ny * (lead - diag) * 0.35 - h / 2
        y0 = y0_base

        # «лесенка» при наложении плашек, как на скриншоте
        for k in range(10):
            box = (x0, y0, w, h)
            hit = any(not (box[0] + w < b[0] or b[0] + b[2] < box[0] or
                           box[1] + h < b[1] or b[1] + b[3] < box[1])
                      for b in occupied)
            if not hit:
                break
            step = (h + ch * 0.35) * (k // 2 + 1)
            y0 = y0_base + (step if k % 2 == 0 else -step)
        occupied.append((x0, y0, w, h))

        polka_x = x0 if nx >= 0 else x0 + w
        lines = [(r["mark"] or "·", r["pid"], f"{r['dp']:+.0f}", r["over"])
                 for r in ordered]

        flags.append({
            "rows": ordered, "anchor": anchor, "elbow": (ex, ey),
            "polka": (polka_x, y0 + h / 2),
            "box": (x0, y0, w, h), "ch": ch,
            "cols": (lw, iw, vw), "lines": lines,
            "pair": len(ordered) > 1,
        })
    return flags


