NEAR_M = 5.0
SWAP_RATIO = 3.0
SHIFT_M = 50.0


@dataclass
class CSReport:
    direct: float
    swapped: float
    c_txt: Tuple[float, float]
    c_txt_sw: Tuple[float, float]
    c_dxf: Tuple[float, float]
    ok: bool
    suggest_swap: bool
    need_shift: bool

    @property
    def best(self) -> float:
        return min(self.direct, self.swapped)


def _seg_xy_dist(px: float, py: float, s) -> float:
    ax, ay, bx, by = s.ax, s.ay, s.bx, s.by
    vx, vy = bx - ax, by - ay
    L2 = vx * vx + vy * vy
    if L2 < 1e-18:
        return math.hypot(px - ax, py - ay)
    t = ((px - ax) * vx + (py - ay) * vy) / L2
    t = 0.0 if t < 0.0 else (1.0 if t > 1.0 else t)
    return math.hypot(px - (ax + t * vx), py - (ay + t * vy))


def _median_nearest(points, segments) -> float:
    if not points or not segments:
        return float("inf")
    return statistics.median(
        min(_seg_xy_dist(x, y, s) for s in segments) for x, y in points
    )


def _centroid_xy(points):
    if not points:
        return (0.0, 0.0)
    return (sum(p[0] for p in points) / len(points),
            sum(p[1] for p in points) / len(points))


def check_cs(txt_points, dxf_segments, shift=(0.0, 0.0)) -> CSReport:
    direct_pts = [(x, y) for _, x, y, _ in txt_points]
    swap_pts = [(y, x) for _, x, y, _ in txt_points]
    dxf_pts = []
    for s in dxf_segments:
        dxf_pts += [(s.ax, s.ay), (s.bx, s.by)]
    d0 = _median_nearest(direct_pts, dxf_segments)
    d1 = _median_nearest(swap_pts, dxf_segments)
    ok = d0 <= NEAR_M
    suggest = (not ok) and (d1 < d0) and (d1 <= NEAR_M or d1 * SWAP_RATIO <= d0)
    return CSReport(d0, d1, _centroid_xy(direct_pts), _centroid_xy(swap_pts),
                    _centroid_xy(dxf_pts), ok, suggest, (not ok) and (not suggest))


