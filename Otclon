def ensure_cyr_style(doc) -> str:
    """STYLE с TTF: Standard/txt.shx кириллицу не содержит."""
    if "CYR" in doc.styles:
        return "CYR"
    try:
        st = doc.styles.new("CYR", dxfattribs={"font": DXF_CYR_FONT})
    except Exception:
        st = doc.styles.new("CYR")
    try:
        st.dxf.font = DXF_CYR_FONT             # группа 3 таблицы STYLE
    except Exception:
        pass
    return "CYR"


