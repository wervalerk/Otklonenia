            f"Ошибка: `{md_code(e)}`",
            parse_mode=ParseMode.MARKDOWN,
        )
        return

    stem = out_stem(data)
    name_mode = data.get("name_mode", "auto")

    out_dxf = os.path.join(data["tmp"], f"{stem}.dxf")
    out_pdf = os.path.join(data["tmp"], f"{stem}.pdf")

    write_dxf(out_dxf, dxf, rows, flags, off, th, txt)
    write_pdf(out_pdf, dxf, rows, flags, txt)

    await state.update_data(out_dxf=out_dxf, out_pdf=out_pdf)
    await state.set_state(Form.ready)

    head_txt = make_head(
        txt,
        dxf,
        rows,
        flags,
        marks,
        swapped=bool(data.get("swap_xy")),
        warn=_med_warn(data, rows),
    )

    head_txt += (
        f"\n📁 Имя файлов: "
        f"*{'Авто' if name_mode == 'auto' else 'своё'}* → "
        f"`{md_code(stem)}.dxf`, `{md_code(stem)}.pdf`."
    )

    await c.message.answer(
        head_txt,
        parse_mode=ParseMode.MARKDOWN,
    )

    dxf_caption = f"{stem}.dxf — отклонения, стрелки, красный >{txt.red_mm:.0f} мм"
    pdf_caption = f"{stem}.pdf — В/Н + цифры, красный >{txt.red_mm:.0f} мм"

    await c.message.answer_document(
        FSInputFile(out_dxf, filename=f"{stem}.dxf"),
        caption=dxf_caption,
    )

    await c.message.answer_document(
        FSInputFile(out_pdf, filename=f"{stem}.pdf"),
        caption=pdf_caption,
        reply_markup=final_kb(),
    )


@dp.callback_query(F.data.startswith("get_"))
async def on_get(c: types.CallbackQuery, state: FSMContext):
    keys = {"get_dxf": "out_dxf", "get_pdf": "out_pdf"}
    caps = {"get_dxf": "DXF ещё раз", "get_pdf": "PDF ещё раз"}

    p = (await state.get_data()).get(keys.get(c.data, ""))
    if not p or not os.path.exists(p):
        await c.answer(
            "Файлы устарели, нажмите /start",
            show_alert=True,
        )
        return

    await c.message.answer_document(
        FSInputFile(p, filename=os.path.basename(p)),
        caption=f"{caps[c.data]}: {os.path.basename(p)}",
        reply_markup=final_kb(),
    )
    await c.answer()


