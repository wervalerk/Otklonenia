def md_code(s) -> str:
    """Текст ошибки внутрь `...`: убираем бэктики и переводы строк."""
    return str(s).replace("`", "'").replace("\r", " ").replace("\n", " ")


PT_MIN, PT_MAX, PT_STEP = 0.40, 3.00, 0.25


def clamp_pt(v: float) -> float:
    return max(PT_MIN, min(PT_MAX, round(float(v) / PT_STEP) * PT_STEP))


def pt_label(v: float) -> str:
    return f"{v:.2f}×"


