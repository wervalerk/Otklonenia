# МОДУЛЬ 0. ПРОВЕРКА СК «TXT ↔ DXF» — запускается ПЕРВЫМ после двух файлов
# Не зависит от расчёта отклонений. Работает с «сырыми» точками TXT и
# сегментами DXF (уже приведёнными к метрам и сдвинутыми на SHIFT).
# Гипотезы считаются ОТНОСИТЕЛЬНО ТЕКУЩЕЙ ориентации TXT:
#   A «как сейчас»  и  B «инвертировать X↔Y».
# ═══════════════════════════════════════════════════════════════════════════

NEAR_M = 5.0        # «рядом»: медиана до ближайшего контура, м
SWAP_RATIO = 3.0    # во сколько раз X↔Y должна улучшить, чтобы предложить кнопку
SHIFT_M = 50.0      # выше этого → просим X0 Y0 (привязку, НЕ авто-совмещение)


@dataclass
class CSReport:
    direct: float                       # медиана при текущей ориентации
    swapped: float                      # медиана при инверсии X↔Y
    c_txt: Tuple[float, float]
    c_txt_sw: Tuple[float, float]
    c_dxf: Tuple[float, float]
    ok: bool                            # уже рядом
    suggest_swap: bool                  # перестановка явно помогает
    need_shift: bool                    # не помогло ничего → нужен X0 Y0

    @property
    def best(self) -> float:
        return min(self.direct, self.swapped)


def _seg_xy_dist(px: float, py: float, s) -> float:
    """Расстояние от точки до ОТРЕЗКА (с clamp t), только план, без Z."""
    ax, ay, bx, by = s.ax, s.ay, s.bx, s.by
    vx, vy = bx - ax, by - ay
    L2 = vx * vx + vy * vy
    if L2 < 1e-18:
        return math.hypot(px - ax, py - ay)
    t = ((px - ax) * vx + (py - ay) * vy) / L2
    t = 0.0 if t < 0.0 else (1.0 if t > 1.0 else t)
    return math.hypot(px - (ax + t * vx), py - (ay + t * vy))


def _median_nearest(points, segments) -> float:
    if not points or not segments:
        return float("inf")
    return statistics.median(
        min(_seg_xy_dist(x, y, s) for s in segments) for x, y in points
    )


def _centroid_xy(points):
    if not points:
        return (0.0, 0.0)
    return (sum(p[0] for p in points) / len(points),
            sum(p[1] for p in points) / len(points))


def check_cs(txt_points, dxf_segments, shift=(0.0, 0.0)) -> CSReport:
    """
    A: TXT в текущей ориентации vs DXF+S
    B: TXT с инвертированными X/Y   vs DXF+S   ← «поменять столбцы»

    Меняем ТОЛЬКО столбцы X/Y в TXT, SHIFT один и тот же. Гипотеза
    «поменять SHIFT» не нужна:
      dist((X,Y), DXF+swap(S)) == dist((Y,X), DXF+S)  → это уже B,
      dist((Y,X), DXF+swap(S)) == dist((X,Y), DXF+S)  → это уже A.
    """
    direct_pts = [(x, y) for _, x, y, _ in txt_points]
    swap_pts = [(y, x) for _, x, y, _ in txt_points]

    dxf_pts = []
    for s in dxf_segments:
        dxf_pts.append((s.ax, s.ay))
        dxf_pts.append((s.bx, s.by))

    d0 = _median_nearest(direct_pts, dxf_segments)
    d1 = _median_nearest(swap_pts, dxf_segments)

    ok = d0 <= NEAR_M
    suggest = (not ok) and (d1 < d0) and (
        d1 <= NEAR_M or d1 * SWAP_RATIO <= d0
    )
    need_shift = (not ok) and (not suggest)

    return CSReport(
        direct=d0, swapped=d1,
        c_txt=_centroid_xy(direct_pts),
        c_txt_sw=_centroid_xy(swap_pts),
        c_dxf=_centroid_xy(dxf_pts),
        ok=ok, suggest_swap=suggest, need_shift=need_shift,
    )


