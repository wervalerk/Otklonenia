def num(tok: str) -> float:
    return float(tok.strip().replace(",", "."))


HINT = {"ВЕРХ": "В", "НИЗ": "Н", "В": "В", "Н": "Н"}


@dataclass
class TxtData:
    points: List[Tuple[str, float, float, float]]   # №, X, Y, H — H ТОЛЬКО для яруса
    shift: Tuple[float, float] = (0.0, 0.0)
    tol_mm: float = 10.0
    level_tol: float = 0.05        # ТОЛЬКО привязка контура по Z в DXF
    pair_r: float = 0.30           # радиус поиска пары по XY, м
    pair_z: float = 0.50           # мин. ΔH, чтобы считать парой Н/В, м
    dxfunits: Optional[str] = None
    flagbox: bool = True
    explicit: Dict[str, str] = field(default_factory=dict)  # необязательная подсказка
    pt_k: float = 1.0
    pt_set: bool = False           # задан ли # PTS в файле


def parse_txt(path: str) -> TxtData:
    points, shift, tol, lvl, dxfunits = [], (0.0, 0.0), 10.0, 0.05, None
    pair_r, pair_z, flagbox, txt_units, pt_k, pt_set = 0.30, 0.50, True, "m", 1.0, False
    explicit: Dict[str, str] = {}

    for raw in Path(path).read_text(encoding="utf-8-sig", errors="replace").splitlines():
        line = raw.strip()
        if not line:
            continue

        # ── настройки ────────────────────────────────────────────────
        if line.startswith("#"):
            if re.match(r"#\s*(Hпр|HPRJ|HPROJ|H)\s*=", line, re.I):
                continue
            m = re.match(r"#\s*SHIFT\s*=\s*([+-]?[\d.,]+)[;\s]+([+-]?[\d.,]+)", line, re.I)
            if m:
                shift = (num(m.group(1)), num(m.group(2))); continue
            m = re.match(r"#\s*TOL\s*=\s*([\d.,]+)", line, re.I)
            if m:
                tol = num(m.group(1)); continue
            m = re.match(r"#\s*(?:LEVELTOL|LEVEL)\s*=\s*([\d.,]+)", line, re.I)
            if m:
                lvl = num(m.group(1)); continue
            m = re.match(r"#\s*PAIRR\s*=\s*([\d.,]+)", line, re.I)
            if m:
                pair_r = num(m.group(1)); continue
            m = re.match(r"#\s*PAIRZ\s*=\s*([\d.,]+)", line, re.I)
            if m:
                pair_z = num(m.group(1)); continue
            m = re.match(r"#\s*(?:PTS|PTK|PT|POINTSIZE)\s*=\s*([\d.,]+)", line, re.I)
            if m:
                pt_k, pt_set = num(m.group(1)), True; continue
            m = re.match(r"#\s*FLAGBOX\s*=\s*(0|1|off|on)", line, re.I)
            if m:
                flagbox = m.group(1).lower() in ("1", "on"); continue
            m = re.match(r"#\s*DXFUNITS\s*=\s*(mm|cm|m)\b", line, re.I)
            if m:
                dxfunits = m.group(1).lower(); continue
            m = re.match(r"#\s*UNITS\s*=\s*(mm|m)\b", line, re.I)
            if m:
                txt_units = m.group(1).lower(); continue
            continue

        # ── строка точки ─────────────────────────────────────────────
        line = line.split("#", 1)[0].strip()
        if not line:
            continue

        s = line.replace(";", " ").replace("\t", " ")
        if re.search(r"\s", s):
            # есть пробелы/таб/';' → запятая между цифрами = ДЕСЯТИЧНАЯ,
            # остальные запятые = разделители
            s = re.sub(r"(?<=\d),(?=\d)", ".", s)
            s = s.replace(",", " ")
            toks = s.split()
        else:
            # «чистый» экспорт тахеометра: 0,9505.1690,2865.1403,169.0364,,,,,,
            toks = s.split(",")

        fields = [t.strip() for t in toks if t.strip()]
        if len(fields) < 4:
            raise ValueError(
                f"Нужно минимум 4 поля (№ X Y H), получили {len(fields)}: {raw!r}"
            )

        if len(fields) >= 5 and re.fullmatch(r"[+-]?\d+(?:\.\d+)?", fields[4]):
            raise ValueError(
                f"Похоже, 5-м полем оказалось число {fields[4]!r}: {raw!r}. "
                "Скорее всего координаты перечислены через запятые либо число "
                "разбито пробелом. Разделители: ';', пробел; десятичная — ',' "
                "или '.' (в чистом CSV только '.')."
            )

        pid = fields[0]
        x, y, h = (num(v) for v in fields[1:4])

        # 5-е непустое поле: В/Н — необязательная ПОДСКАЗКА, код/атрибут — игнор
        if len(fields) >= 5:
            hint = HINT.get(fields[4].upper())
            if hint:
                explicit[pid] = hint
        m = re.match(r"^(.*?)[/_\-]?(В|Н)$", pid, re.I)
        if m and pid not in explicit:
            explicit[pid] = m.group(2).upper()

        k = 0.001 if txt_units == "mm" else 1.0
        points.append((pid, x * k, y * k, h * k))

    if not points:
        raise ValueError("В TXT нет ни одной точки.")
    return TxtData(
        points=points, shift=shift, tol_mm=tol, level_tol=lvl,
        pair_r=max(pair_r, 1e-6), pair_z=max(pair_z, 1e-6),
        dxfunits=dxfunits, flagbox=flagbox, explicit=explicit,
        pt_k=clamp_pt(pt_k), pt_set=pt_set,
    )


# ─────────────────── Яруса (В/Н определяет приложение) ───────────────────

def cluster_levels(values, tol: float) -> List[float]:
    vals = sorted(v for v in values if math.isfinite(v))
    if not vals:
        return []
    groups = [[vals[0]]]
    for v in vals[1:]:
        if v - groups[-1][-1] <= tol:
            groups[-1].append(v)
        else:
            groups.append([v])
    return [sum(g) / len(g) for g in groups]


def pid_sort(r) -> tuple:
    p = r["pid"]
    return (0, int(p), "") if p.isdigit() else (1, 0, p)


def xy_groups(rows, radius: float):
    unused = list(rows)
    out = []
    while unused:
        seed = unused.pop(0)
        g = [seed]
        i = 0
        while i < len(unused):
            if math.hypot(unused[i]["p"][0] - seed["p"][0],
                          unused[i]["p"][1] - seed["p"][1]) <= radius:
                g.append(unused.pop(i))
            else:
                i += 1
        out.append(g)
    return out


def max_gap_threshold(hs: List[float]) -> float:
    v = sorted(hs)
    if len(v) < 2:
        return v[0] if v else 0.0
    gaps = [(v[i + 1] - v[i], (v[i] + v[i + 1]) / 2) for i in range(len(v) - 1)]
    return max(gaps)[1]


def assign_marks(rows, txt: TxtData, dxf) -> dict:
    """
    В/Н определяем САМИ, без ввода пользователя:
    1) близкие по XY → пара, если ΔH >= PAIRZ
    2) в паре: меньшая H = Н, большая H = В (порядок строк не важен)
    3) порог для одиночек = медиана середин найденных пар
    4) одиночка: H < порога → Н, иначе → В
    """
    for r in rows:
        r.pop("pair_key", None)
        r.pop("mark", None)

    mids, npair = [], 0
    for g in xy_groups(rows, txt.pair_r):
        g.sort(key=lambda r: r["h"])
        while len(g) >= 2 and (g[-1]["h"] - g[0]["h"]) >= txt.pair_z:
            lo, hi = g.pop(0), g.pop()
            key = f"P{npair}"; npair += 1
            lo["mark"], hi["mark"] = MARKS[0], MARKS[1]
            lo["pair_key"] = hi["pair_key"] = key
            mids.append((lo["h"] + hi["h"]) / 2.0)

    hs = [r["h"] for r in rows]
    if mids:
        thr, src = statistics.median(mids), "медиана середин пар"
    elif len(dxf.level_reps) >= 2:
        thr, src = sum(dxf.level_reps) / 2.0, "Z контуров DXF"
    else:
        thr, src = max_gap_threshold(hs), "макс. разрыв H"

    nalone = 0
    for r in rows:
        if "mark" not in r:
            r["mark"] = MARKS[1] if r["h"] >= thr else MARKS[0]
            r["pair_key"] = None
            nalone += 1
        if r["pid"] in txt.explicit:
            r["mark"] = txt.explicit[r["pid"]]
        r["lname"] = (f"{MARKS[0]} (низ) H {r['h']:+.3f}" if r["mark"] == MARKS[0]
                      else f"{MARKS[1]} (верх) H {r['h']:+.3f}")

    return {"thr": thr, "pairs": npair, "alone": nalone, "src": src}


