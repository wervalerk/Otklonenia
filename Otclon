def write_dxf(path, dxf, rows, flags, off, th, txt):
    doc = ezdxf.new("R2010")
    doc.header["$INSUNITS"] = 6
    doc.header["$MEASUREMENT"] = 1
    doc.header["$PDMODE"] = 3
    doc.header["$PDSIZE"] = off * 0.30 * txt.pt_k
    style = ensure_cyr_style(doc)

    fact_aci = 1 if CROSS_COLOR == RED else 7

    # ── слои: LEAD зарезервирован, чтобы будущие выноски не упали ──
    for name, color in (
        ("PROJ", 8),
        ("FACT", fact_aci),
        ("ARROW", 7),
        ("LEAD", 8),
        ("DELTA", 7),
        ("OVER", 1),
        ("TAG", 7),
    ):
        ensure_layer(doc, name, color)

    msp = doc.modelspace()

    for pts, closed, _ in dxf.polylines:
        xy = [(p[0], p[1]) for p in pts]
        if closed and len(xy) > 2 and math.hypot(
            xy[-1][0] - xy[0][0],
            xy[-1][1] - xy[0][1],
        ) < 1e-9:
            xy = xy[:-1]
        msp.add_lwpolyline(
            xy,
            close=closed,
            dxfattribs={"layer": "PROJ", "elevation": pts[0][2]},
        )

    cr = off * 0.30 * txt.pt_k
    for r in rows:
        x, y = r["p"]
        msp.add_point((x, y), dxfattribs={"layer": "FACT"})
        msp.add_line(
            (x - cr, y),
            (x + cr, y),
            dxfattribs={"layer": "FACT"},
        )
        msp.add_line(
            (x, y - cr),
            (x, y + cr),
            dxfattribs={"layer": "FACT"},
        )

    ch = off * 0.70 * TEXT_SCALE
    fs = ch * 0.78   # буква и цифра одной высоты

    for f in flags:
        ar = f["arrow"]
        msp.add_line(
            ar["start"],
            ar["end"],
            dxfattribs={"layer": "ARROW"},
        )
        msp.add_line(
            ar["end"],
            ar["a1"],
            dxfattribs={"layer": "ARROW"},
        )
        msp.add_line(
            ar["end"],
            ar["a2"],
            dxfattribs={"layer": "ARROW"},
        )

        x0, y0, _, _ = f["box"]
        lw, vw = f["cols"]
        row_h = f["row_h"]
        cnt = len(f["lines"])
        ang = f["angle"]

        for k, (letter, val, hot) in enumerate(f["lines"]):
            yy = y0 + (cnt - 1 - k) * row_h + row_h * 0.18

            # буква и цифра ближе друг к другу (допускается лёгкое наложение)
            msp.add_text(letter, dxfattribs={
                "layer": "TAG",
                "style": style,
                "height": fs,
                "rotation": ang,
                "color": 7,
                "insert": (x0 + lw * 0.05, yy),
            })

            msp.add_text(val, dxfattribs={
                "layer": "TAG",
                "style": style,
                "height": fs,
                "rotation": ang,
                "color": 1 if hot else 7,
                "insert": (x0 + lw * 0.85, yy),  # ближе к букве, лёгкое наложение OK
            })

    doc.saveas(path)


